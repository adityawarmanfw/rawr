#version 450
#extension GL_GOOGLE_include_directive : require
// Still/video highlight stage (RAWR_HL_SCALE 2), source to destination.
//   enabled 0: off, common-ceiling clamp only.
//   enabled 1: colour-propagation reconstruction.
//   enabled 2: passthrough; Inpaint Opposed (coloropp.comp) already repaired
//              the pre-WB RGB, so preserve its post-WB signal for FCC,
//              tonemap, and the UltraHDR HDR tap.
layout(local_size_x = 16, local_size_y = 16) in;
layout(binding = 0, rgba16f) uniform readonly image2D srcImage;
layout(binding = 1, rgba16f) uniform writeonly image2D dstImage;
layout(binding = 2, r16ui) uniform readonly uimage2D clipStateImage;  // pre-LSC sensor clipping
layout(binding = 3, rgba16f) uniform readonly image2D guideImage;
layout(push_constant) uniform Pc {
    uint width;
    uint height;
    uint enabled;
    uint unalignedClipMask;  // distortion-resampled RGB uses the legacy numeric fallback
    vec4 channelCeilings;
}
pc;

#include "raw_highlight_post_rgb.glsl"
#include "highlight_guide_sample.glsl"

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= int(pc.width) || p.y >= int(pc.height)) return;
    vec4 original = imageLoad(srcImage, p);
    if (pc.enabled == 2u) {
        imageStore(dstImage, p, vec4(rawrHighlightSanitize(original.rgb), original.a));
        return;
    }
    bool recoverDetail = pc.enabled != 0u;
    vec3 repair = pc.unalignedClipMask != 0u
        ? rawrHighlightRepairWeights(original.rgb, pc.channelCeilings.rgb)
        : rawrHighlightSensorRepair(p);
    bool needsGuide = recoverDetail && rawrHighlightMaximum(repair) > 0.0;
    vec4 guide = needsGuide ? rawrHighlightGuideAt(p) : vec4(0.0);
    vec3 recovered;
    if (!recoverDetail) {
        recovered = reconstructPostWbHighlight(original.rgb, pc.channelCeilings.rgb, guide.rgb, false, false);
    } else {
        bool normalizedValid;
        vec3 normalizedGuide = rawrHighlightNormalizeGuide(guide.rgb, normalizedValid);
        recovered = rawrHighlightRecoverDetailWithRepair(
            rawrHighlightSanitize(original.rgb), max(pc.channelCeilings.rgb, vec3(1e-4)), normalizedGuide,
            normalizedValid && rawrHighlightSum(guide.rgb) > 1e-6, repair,
        all(greaterThan(repair, vec3(0.5))) ? rawrHighlightCoreFraction(p) : 1.0);
        recovered = rawrHighlightSanitize(recovered);
    }
    imageStore(dstImage, p, vec4(recovered, original.a));
}
