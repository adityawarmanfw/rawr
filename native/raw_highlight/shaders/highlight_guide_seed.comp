#version 450
#extension GL_GOOGLE_include_directive : require
// Colour-propagation seed: one guide cell per 4 (preview) or 8 (still) working
// pixels. Only bright, unclipped, locally smooth pixels may describe
// highlight colour; dark edges and silhouettes cannot seed it.
#ifndef RAWR_HL_SEED_GROUP_SIZE
#if RAWR_HL_SCALE == 1
#define RAWR_HL_SEED_GROUP_SIZE 8
#else
#define RAWR_HL_SEED_GROUP_SIZE 16
#endif
#endif
layout(local_size_x = RAWR_HL_SEED_GROUP_SIZE, local_size_y = RAWR_HL_SEED_GROUP_SIZE) in;
layout(binding = 0, rgba16f) uniform readonly image2D rgbImage;
layout(binding = 1, r16ui) uniform readonly uimage2D clipStateImage;
layout(binding = 2, rgba16f) uniform writeonly image2D guideImage;
layout(push_constant) uniform Pc {
    uint width;
    uint height;
    uint guideWidth;
    uint guideHeight;
    vec4 channelCeilings;
}
pc;

#include "raw_highlight_post_rgb.glsl"
#ifndef RAWR_HL_SEED_EARLY_REJECT
#if RAWR_HL_SCALE == 1
#define RAWR_HL_SEED_EARLY_REJECT 1
#else
#define RAWR_HL_SEED_EARLY_REJECT 0
#endif
#endif
#ifndef RAWR_HL_SEED_CHANNEL_BOUND
#if RAWR_HL_SCALE == 1
#define RAWR_HL_SEED_CHANNEL_BOUND 1
#else
#define RAWR_HL_SEED_CHANNEL_BOUND 0
#endif
#endif
#ifndef RAWR_HL_SEED_DEFER_STATE
#if RAWR_HL_SCALE == 1
#define RAWR_HL_SEED_DEFER_STATE 1
#else
#define RAWR_HL_SEED_DEFER_STATE 0
#endif
#endif
#if !defined(RAWR_HL_SCALE) || (RAWR_HL_SCALE != 1 && RAWR_HL_SCALE != 2)
#error "RAWR_HL_SCALE must be 1 (preview) or 2 (still)"
#endif
const int kStep = RAWR_HL_SCALE;

uint clipState(ivec2 p) {
#if RAWR_HL_SCALE == 1
    return imageLoad(clipStateImage, clamp(p, ivec2(0), ivec2(pc.width, pc.height) - ivec2(1))).r & 15u;
#else
    ivec2 stateExtent = imageSize(clipStateImage);
    return imageLoad(clipStateImage, clamp(p >> 1, ivec2(0), stateExtent - ivec2(1))).r & 15u;
#endif
}
bool fullyValid(ivec2 p) { return clipState(p) == 0u; }

void main() {
    ivec2 g = ivec2(gl_GlobalInvocationID.xy);
    if (g.x >= int(pc.guideWidth) || g.y >= int(pc.guideHeight)) return;
    ivec2 extent = ivec2(pc.width, pc.height);
    ivec2 origin = g * (4 * kStep);
    vec3 chromaSum = vec3(0.0);
    float weightSum = 0.0;
    vec3 observedSum = vec3(0.0);
#if RAWR_HL_SEED_EARLY_REJECT
    vec3 ceilings = max(pc.channelCeilings.rgb, vec3(1e-4));
#if RAWR_HL_SEED_CHANNEL_BOUND
    vec3 darkSeedCeiling = 0.5 * ceilings;
#else
    float darkSeedCeiling = 0.5 * min(ceilings.r, min(ceilings.g, ceilings.b));
#endif
#endif
    // Sixteen spatially distributed samples per cell.
    for (int y = kStep - 1; y < 4 * kStep; y += kStep) {
        for (int x = kStep - 1; x < 4 * kStep; x += kStep) {
            ivec2 p = clamp(origin + ivec2(x, y), ivec2(0), extent - ivec2(1));
#if !RAWR_HL_SEED_DEFER_STATE
            uint state = clipState(p);
#endif
            vec3 rgb = rawrHighlightSanitize(imageLoad(rgbImage, p).rgb);
            observedSum += rgb;
#if !RAWR_HL_SEED_DEFER_STATE
            if (state != 0u) continue;
#endif
#if RAWR_HL_SEED_EARLY_REJECT
            // Component-wise half-ceiling rejection is strictly inside the
            // existing 0.52 eligibility bound, including unequal white balance.
            // It avoids the scalar minimum's unnecessarily weak red/blue test.
            // Avoid neighbour loads for dark pixels without moving the more
            // expensive per-channel divisions ahead of neighbour rejection.
#if RAWR_HL_SEED_CHANNEL_BOUND
            if (all(lessThan(rgb, darkSeedCeiling))) continue;
#else
            if (rawrHighlightMaximum(rgb) < darkSeedCeiling) continue;
#endif
#endif
#if RAWR_HL_SEED_DEFER_STATE
            if (clipState(p) != 0u) continue;
#endif
            ivec2 px0 = clamp(p - ivec2(kStep, 0), ivec2(0), extent - ivec2(1));
            ivec2 px1 = clamp(p + ivec2(kStep, 0), ivec2(0), extent - ivec2(1));
            ivec2 py0 = clamp(p - ivec2(0, kStep), ivec2(0), extent - ivec2(1));
            ivec2 py1 = clamp(p + ivec2(0, kStep), ivec2(0), extent - ivec2(1));
            if (!fullyValid(px0) || !fullyValid(px1) || !fullyValid(py0) || !fullyValid(py1)) continue;
            float sum = rawrHighlightSum(rgb);
            if (sum <= 1e-6) continue;
            float peak = rawrHighlightMaximum(rgb / max(pc.channelCeilings.rgb, vec3(1e-4)));
            // The sensor mask already excludes clipped channels. Lens shading
            // may legitimately put valid seeds above the nominal WB ceiling.
            if (peak < 0.52) continue;
            vec3 dx = imageLoad(rgbImage, px1).rgb - imageLoad(rgbImage, px0).rgb;
            vec3 dy = imageLoad(rgbImage, py1).rgb - imageLoad(rgbImage, py0).rgb;
            float variation = max(rawrHighlightMaximum(abs(dx)), rawrHighlightMaximum(abs(dy))) / sum;
            if (variation > 0.10) continue;
            float w = smoothstep(0.52, 0.78, peak) * (1.0 / (1.0 + 24.0 * variation));
            chromaSum += (rgb / sum) * w;
            weightSum += w;
        }
    }
    vec3 chroma = weightSum > 1e-6 ? chromaSum / weightSum : vec3(0.0);
    float observedPeak = rawrHighlightMaximum(observedSum / 16.0);
    // Negative alpha marks an authoritative chroma seed while also carrying a
    // low-resolution brightness field. This field suppresses high-frequency
    // false texture without flattening broad cloud structure.
    float alpha = weightSum > 1e-6 ? -(1.0 + observedPeak) : observedPeak;
    imageStore(guideImage, g, vec4(chroma, alpha));
}
