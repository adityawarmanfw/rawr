    vec4 s = imageLoad(sumI, localO), w = imageLoad(weightI, localO);
    vec3 frameWeight = vec3(0);
    rawrTrace4(100u, o, 0u, vec4(ref, mv));
    rawrTrace4(101u, o, 0u, vec4(f, r, float(rq.x)));
    for (int y = -1; y <= 1; y++)
        for (int x = -1; x <= 1; x++) {
            ivec2 q = c + ivec2(x, y);
            if (any(lessThan(q, ivec2(0))) || any(greaterThanEqual(q, imageSize(rawI)))) continue;
            int cc = ch(q);
            uint tap = uint((y + 1) * 3 + x + 1);
