            // estimates from changing the reconstruction filter across frames.
            precise float k = kw(vec2(q) - (mv - .5), (ref - .5) / 2, o, tap);
            precise float ww = k * r;
            precise float samp = imageLoad(rawI, q).x;
            rawrTrace4(120u, o, tap, vec4(float(cc), samp, k, ww));
            precise float sv = samp * ww;
