#version 450
// Multiframe accumulate: any 2x2 Bayer arrangement (CfaPattern codes 0..3).
#ifdef RAWR_PARITY_TRACE
layout(std430, set = 0, binding = 31) buffer RawrTraceBuffer {
    uint writeCount;
    uint droppedCount;
    uint _p0;
    uint _p1;
    uvec4 cfg0;
    ivec4 cfg1;
    uvec4 meta[];
}
rawrTrace;
const uint RAWR_TRACE_STAGE = 17u;
bool rawrTraceMatch(ivec2 q) {
    if (rawrTrace.cfg0.x == 0u) return false;
    if (rawrTrace.cfg0.y != 0u && rawrTrace.cfg0.y != RAWR_TRACE_STAGE) return false;
    int tx = int(rawrTrace.cfg0.z), ty = int(rawrTrace.cfg0.w);
    return (tx < 0 || q.x == tx) && (ty < 0 || q.y == ty);
}
void rawrTrace4(uint cp, ivec2 q, uint aux, vec4 v) {
    if (!rawrTraceMatch(q)) return;
    uint i = atomicAdd(rawrTrace.writeCount, 1u);
    uint cap = uint(max(rawrTrace.cfg1.x, 0));
    if (i >= cap) {
        atomicAdd(rawrTrace.droppedCount, 1u);
        return;
    }
    uint b = i * 2u;
    rawrTrace.meta[b] = uvec4(RAWR_TRACE_STAGE, cp, uint(q.x), uint(q.y));
    rawrTrace.meta[b + 1u] = uvec4(aux, floatBitsToUint(v.x), floatBitsToUint(v.y), floatBitsToUint(v.z));
}
#else
void rawrTrace4(uint cp, ivec2 q, uint aux, vec4 v) {}
#endif
layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 0, r32f) readonly uniform image2D rawI;
layout(set = 0, binding = 1, rg32f) readonly uniform image2D tileFlow;
layout(set = 0, binding = 2, r8ui) readonly uniform uimage2D validI;
layout(set = 0, binding = 3, r32f) readonly uniform image2D robust;
layout(set = 0, binding = 4, rgba32f) readonly uniform image2D covI;
layout(set = 0, binding = 5, rgba32f) uniform image2D sumI;
layout(set = 0, binding = 6, rgba32f) uniform image2D weightI;
layout(set = 0, binding = 7, r32f) uniform image2D squareBI;
layout(push_constant) uniform P {
    float scale;
    int outW;
    int outH;
    int tileSize;
    int cfa;
    int yBase;
}
p;
// Vulkan permits the backend to choose the native float-to-storage conversion.
// MoltenVK's Metal path truncates some positive values at FP16 boundaries, while
// the frozen CPU contract uses IEEE round-to-nearest-even.  Round in integer
// space first, then hand imageStore an exactly representable binary16 value.
uint rawrHalfBitsRte(float v) {
    uint f = floatBitsToUint(v), sign = (f >> 16u) & 0x8000u, a = f & 0x7fffffffu;
    uint mant = a & 0x007fffffu, exp = (a >> 23u) & 0xffu;
    if (exp == 0xffu) {
        uint hm = mant >> 13u;
        if (mant != 0u && hm == 0u) hm = 1u;
        return sign | 0x7c00u | hm;
    }
    int he = int(exp) - 112;
    if (he <= 0) {
        if (he < -10) return sign;
        uint sig = mant | 0x00800000u, shift = uint(14 - he);
        uint q = sig >> shift, rem = sig & ((1u << shift) - 1u), mid = 1u << (shift - 1u);
        if (rem > mid || (rem == mid && (q & 1u) != 0u)) q++;
        return sign | q;
    }
    if (he >= 31) return sign | 0x7c00u;
    uint q = mant >> 13u, rem = mant & 0x1fffu;
    if (rem > 0x1000u || (rem == 0x1000u && (q & 1u) != 0u)) q++;
    if (q == 0x400u) {
        q = 0u;
        he++;
        if (he >= 31) return sign | 0x7c00u;
    }
    return sign | (uint(he) << 10u) | q;
}
float rawrHalfBitsToFloat(uint h) {
    uint sign = (h & 0x8000u) << 16u, exp = (h >> 10u) & 31u, mant = h & 0x3ffu;
    if (exp == 0u) {
        if (mant == 0u) return uintBitsToFloat(sign);
        int p = findMSB(mant);
        return uintBitsToFloat(sign | (uint(p + 103) << 23u) | ((mant - (1u << uint(p))) << uint(23 - p)));
    }
    if (exp == 31u) return uintBitsToFloat(sign | 0x7f800000u | (mant << 13u));
    return uintBitsToFloat(sign | ((exp + 112u) << 23u) | (mant << 13u));
}
float rawrRoundHalfRte(float v) { return rawrHalfBitsToFloat(rawrHalfBitsRte(v)); }
vec4 rawrRoundHalfRte(vec4 v) {
    return vec4(rawrRoundHalfRte(v.x), rawrRoundHalfRte(v.y), rawrRoundHalfRte(v.z), rawrRoundHalfRte(v.w));
}
// Exact helpers remain available for targeted forensic builds. Production uses
// native arithmetic after the full tolerance matrix proved it sufficient.
bool rawrExactAccumulateArithmetic() { return false; }
float rawrDivF32(float af, float bf) {
    if (!rawrExactAccumulateArithmetic()) return af / bf;
    uint ab = floatBitsToUint(af), bb = floatBitsToUint(bf);
    uint amag = ab & 0x7fffffffu, bmag = bb & 0x7fffffffu;
    if (amag == 0u || bmag == 0u) return af / bf;
    uint ae = (ab >> 23) & 255u, be = (bb >> 23) & 255u;
    if (ae == 0u || be == 0u || ae == 255u || be == 255u) return af / bf;
    uint am = 0x800000u | (ab & 0x7fffffu), bm = 0x800000u | (bb & 0x7fffffu);
    int e = int(ae) - int(be) + 127;
    uint q, rem;
    int steps;
    if (am >= bm) {
        q = 1u;
        rem = am - bm;
        steps = 23;
    } else {
        q = 0u;
        rem = am;
        steps = 24;
        e--;
    }
    for (int j = 0; j < 24; j++) {
        if (j >= steps) break;
        rem <<= 1;
        q <<= 1;
        if (rem >= bm) {
            rem -= bm;
            q |= 1u;
        }
    }
    uint twice = rem << 1;
    bool up = (twice > bm) || (twice == bm && ((q & 1u) != 0u));
    if (up) {
        q++;
        if (q == 0x1000000u) {
            q >>= 1;
            e++;
        }
    }
    if (e <= 0 || e >= 255) return af / bf;
    return uintBitsToFloat(((ab ^ bb) & 0x80000000u) | (uint(e) << 23) | (q & 0x7fffffu));
}
// Portable, faithfully-rounded binary32 exponential for the Gaussian weight
// range. Range reduction keeps r in roughly [-ln(2)/2, ln(2)/2], followed by
// a degree-six minimax polynomial and exact power-of-two reconstruction.
float rawrExpF32(float x) {
    if (!rawrExactAccumulateArithmetic()) return exp(x);
    if (isnan(x)) return x;
    if (x < -103.972084f) return 0.0;
    if (x > 88.722839f) return uintBitsToFloat(0x7f800000u);
    precise float nf = floor(fma(x, 1.44269504088896341, 0.5));
    precise float r = fma(nf, -0.693359375, x);
    r = fma(nf, 2.12194440e-4, r);
    precise float r2 = r * r;
    precise float y = 1.9875691500e-4;
    y = fma(y, r, 1.3981999507e-3);
    y = fma(y, r, 8.3334519073e-3);
    y = fma(y, r, 4.1665795894e-2);
    y = fma(y, r, 1.6666665459e-1);
    y = fma(y, r, 5.0000001201e-1);
    y = fma(y, r2, r);
    y = y + 1.0;
    int n = int(nf);
    if (n >= -126) return y * uintBitsToFloat(uint(n + 127) << 23u);
    return (y * uintBitsToFloat(uint(n + 151) << 23u)) * 5.9604644775390625e-8;
}
int ch(ivec2 q) {
    // Shifting to RGGB-relative parity keeps one table for all four patterns:
    // GRBG flips x, GBRG flips y, BGGR flips both.
    int px = (q.x ^ (p.cfa == 1 || p.cfa == 3 ? 1 : 0)) & 1;
    int py = (q.y ^ (p.cfa == 2 || p.cfa == 3 ? 1 : 0)) & 1;
    return (py == 0 && px == 0) ? 0 : (py == 1 && px == 1) ? 2 : 1;
}
bool smoothFlow(vec2 q, out vec2 f) {
    precise vec2 g = (vec2(q) + .5) / float(p.tileSize) - .5;
    ivec2 b = ivec2(floor(g));
    precise vec2 fr = g - vec2(b);
    precise vec2 acc = vec2(0);
    precise float total = 0;
    for (int j = 0; j < 2; j++)
        for (int i = 0; i < 2; i++) {
            ivec2 t = clamp(b + ivec2(i, j), ivec2(0), imageSize(tileFlow) - 1);
            if (imageLoad(validI, t).x == 0u) continue;
            precise float wx = (i == 0 ? 1.0 - fr.x : fr.x);
            precise float wy = (j == 0 ? 1.0 - fr.y : fr.y);
            precise float w = wx * wy;
            acc = fma(vec2(w), imageLoad(tileFlow, t).xy, acc);
            total = total + w;
        }
    if (!(total > 1e-8)) {
        f = vec2(0);
        return false;
    }
    f = acc / total;
    return true;
}
vec3 covAt(vec2 k) {
    vec2 ip = floor(k);
    precise vec2 fr = k - ip;
    ivec2 b = ivec2(ip), n = imageSize(covI);
    ivec2 a = clamp(b, ivec2(0), n - 1), bx = clamp(b + ivec2(1, 0), ivec2(0), n - 1),
          by = clamp(b + ivec2(0, 1), ivec2(0), n - 1), d = clamp(b + ivec2(1), ivec2(0), n - 1);
    vec3 av = imageLoad(covI, a).xyz, bv = imageLoad(covI, bx).xyz, cv = imageLoad(covI, by).xyz,
         dv = imageLoad(covI, d).xyz;
    // V3U proved the CPU companion bilinear covariance interpolation follows FMA.
    precise vec3 db = bv - av, dd = dv - cv;
    precise vec3 t = vec3(fma(fr.x, db.x, av.x), fma(fr.x, db.y, av.y), fma(fr.x, db.z, av.z));
    precise vec3 u = vec3(fma(fr.x, dd.x, cv.x), fma(fr.x, dd.y, cv.y), fma(fr.x, dd.z, cv.z));
    precise vec3 du = u - t;
    precise vec3 outv = vec3(fma(fr.y, du.x, t.x), fma(fr.y, du.y, t.y), fma(fr.y, du.z, t.z));
    return outv;
}
float kw(vec2 d, vec2 k, ivec2 tq, uint tap) {
    vec3 c = covAt(k);
    precise float cy2 = c.y * c.y;
    precise float det = fma(c.x, c.z, -cy2);
    vec3 qi;
    if (!isinf(det) && !isnan(det) && abs(det) > 1e-10) {
        precise float id = rawrDivF32(1.0, det);
        qi = vec3(id * c.z, -id * c.y, id * c.x);
    } else
        qi = vec3(1, 0, 1);
    // Match the frozen ARM CPU contraction of
    // q.xx*dx*dx + 2*q.xy*dx*dy + q.yy*dy*dy: two final FMAs.
    precise float qx = qi.x * d.x;
    precise float qxy2 = qi.y + qi.y;
    precise float qy = qxy2 * d.x;
    qy = qy * d.y;
    precise float z = fma(qx, d.x, qy);
    precise float qyy = qi.z * d.y;
    z = fma(qyy, d.y, z);
    z = max(0.0, z);
    precise float outv = rawrExpF32(-0.5 * z);
    rawrTrace4(110u, tq, tap, vec4(c, det));
    rawrTrace4(111u, tq, tap, vec4(qi, 0));
    rawrTrace4(121u, tq, tap, vec4(d, z, outv));
    return outv;
}

void main() {
    ivec2 localO = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(localO, imageSize(sumI)))) return;
    ivec2 o = ivec2(localO.x, localO.y + p.yBase);
    if (o.x >= p.outW || o.y >= p.outH) return;
    // Output scratch is stripe-local; all reconstruction coordinates remain global.
    vec2 ref = (vec2(o) + .5) / p.scale - .5;
    ivec2 rq = clamp(ivec2(floor((ref + .5) * .5)), ivec2(0), imageSize(robust) / 2 - 1);
    vec2 f;
    // NOTE: flow is evaluated at the continuous ref position. Do not reintroduce
    // a rounded flowQ lookup: rounding snaps neighboring subpixel outputs to
    // identical flow then across discontinuities.
    if (!smoothFlow(ref, f)) return;
    vec2 mv = ref + .5 + f;
    if (any(lessThan(mv, vec2(0))) || any(greaterThanEqual(mv, vec2(imageSize(rawI))))) return;
    float r = imageLoad(robust, rq).x;
    if (!(r > 0.0) || isnan(r) || isinf(r)) return;
