#version 450
// Projects the normalized merge back to integer CFA codes for the merged DNG.
// codeScale widens the sensor's code range to 16 bits so the merge's sub-code
// precision survives quantization; the DNG writer scales the
// BlackLevel/WhiteLevel tags by the same factor. RAWR_SOURCE_R32F reads a
// full-precision normalized CFA plane instead of the RGBA16F merge output.
//
// Values below black are kept (codes under BlackLevel are legal DNG): clamping
// at black turns zero-mean shadow noise into a one-sided floor of exact-black
// codes that raw developers show as crushed, speckled blacks once lifted.
// A 1-LSB TPDF dither keeps quantization unbiased where the merged noise is
// below one code, so lifted shadows do not posterize.

layout(local_size_x = 16, local_size_y = 16) in;
#ifdef RAWR_SOURCE_R32F
layout(set = 0, binding = 0, r32f) readonly uniform image2D mergedCfa;
#else
layout(set = 0, binding = 0, rgba16f) readonly uniform image2D mergedRgb;
#endif
layout(set = 0, binding = 1, r16ui) writeonly uniform uimage2D projectedCfa;

layout(push_constant) uniform Parameters {
    vec4 blackByPhase;
    float whiteLevel;
    uint width;
    uint height;
    uint cfa;
    float codeScale;
}
p;

uint channelForSite(ivec2 q) {
    uint phase = uint((q.y & 1) * 2 + (q.x & 1));
    // Channel indices: R=0, G=1, B=2. CFA IDs match RawMergeWronskiGpu.
    const uvec4 rggb = uvec4(0, 1, 1, 2);
    const uvec4 grbg = uvec4(1, 0, 2, 1);
    const uvec4 gbrg = uvec4(1, 2, 0, 1);
    const uvec4 bggr = uvec4(2, 1, 1, 0);
    return p.cfa == 0u ? rggb[phase] : p.cfa == 1u ? grbg[phase] : p.cfa == 2u ? gbrg[phase] : bggr[phase];
}

// PCG hash (Jarzynski & Olano 2020), two independent uniforms per site.
uint pcg(uint v) {
    uint state = v * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

float tpdf(ivec2 q) {
    uint h0 = pcg(uint(q.x) + pcg(uint(q.y)));
    uint h1 = pcg(h0);
    return float(h0 >> 8) * (1.0 / 16777216.0) + float(h1 >> 8) * (1.0 / 16777216.0) - 1.0;
}

void main() {
    ivec2 q = ivec2(gl_GlobalInvocationID.xy);
    if (q.x >= int(p.width) || q.y >= int(p.height)) return;
    uint phase = uint((q.y & 1) * 2 + (q.x & 1));
#ifdef RAWR_SOURCE_R32F
    float normalized = imageLoad(mergedCfa, q).r;
#else
    vec3 rgb = imageLoad(mergedRgb, q).rgb;
    float normalized = rgb[channelForSite(q)];
#endif
    float range = max(1.0, p.whiteLevel - p.blackByPhase[phase]);
    precise float code = fma(normalized, range, p.blackByPhase[phase]) * p.codeScale;
    uint packed = uint(roundEven(clamp(code + tpdf(q), 0.0, 65535.0)));
    imageStore(projectedCfa, q, uvec4(packed, 0u, 0u, 0u));
}
