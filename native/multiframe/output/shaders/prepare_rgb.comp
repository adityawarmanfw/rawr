#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 16, local_size_y = 16) in;
layout(binding = 0, rgba16f) readonly uniform image2D mergedRgb;
layout(binding = 1, rgba16f) writeonly uniform image2D outRgb;
layout(binding = 2, r16ui) writeonly uniform uimage2D clipState;
layout(std430, binding = 3) readonly buffer LensShading { vec4 gains[]; } lsc;
// Optional reference-frame sensor evidence (1A). Bound at prepare time;
// when unused the adapter binds a valid placeholder view and clears
// useSensorClip, so the sensor term is skipped in-shader.
layout(binding = 4, r16ui) readonly uniform uimage2D refRaw;
// Site chroma only: the re-estimated green of prepare_green.comp (equal to the merged green where the merge kept enough
// frames, and at green sites).
layout(binding = 5, r16f) readonly uniform image2D greenAlt;
layout(push_constant) uniform P {
    uint width, height, lscWidth, lscHeight;
    uint refWidth, refHeight, cfa, useSensorClip;
    vec4 black;
    vec4 invRange;
    float clipThreshold;
    uint siteChromaCfa;   // CFA of the site-chroma rebuild, or > 3: off (see SiteChromaParams)
    float wbR, wbB;
    float noiseSlope, noiseOffset;   // merged noise variance: slope * x + offset (normalised x)
} p;
#include "cfa_common.glsl"

// Merged RGB carries green at every pixel, interpolated from both G_even and
// G_odd sites, so it takes the mean of the two green gains rather than the
// row-parity selection lens_shading.glsl uses for CFA samples.
vec3 gainAt(ivec2 q) {
    vec2 xy = vec2(q) / max(vec2(p.width, p.height) - 1.0, vec2(1));
    xy *= vec2(p.lscWidth - 1u, p.lscHeight - 1u);
    ivec2 lo = ivec2(floor(xy)), hi = min(lo + 1, ivec2(p.lscWidth, p.lscHeight) - 1);
    vec2 f = fract(xy);
    vec4 a = mix(lsc.gains[lo.y * int(p.lscWidth) + lo.x], lsc.gains[lo.y * int(p.lscWidth) + hi.x], f.x);
    vec4 b = mix(lsc.gains[hi.y * int(p.lscWidth) + lo.x], lsc.gains[hi.y * int(p.lscWidth) + hi.x], f.x);
    vec4 g = mix(a, b, f.y);
    return vec3(g.r, .5 * (g.g + g.b), g.a);
}
uint sensorClipForCell(ivec2 cell) {
    ivec2 qr, qg1, qg2, qb;
    rawrCfaCellCoordinates(p.cfa, cell, qr, qg1, qg2, qb);
    ivec2 rawExtent = ivec2(int(p.refWidth), int(p.refHeight));
    qr = clamp(qr, ivec2(0), rawExtent - ivec2(1));
    qg1 = clamp(qg1, ivec2(0), rawExtent - ivec2(1));
    qg2 = clamp(qg2, ivec2(0), rawExtent - ivec2(1));
    qb = clamp(qb, ivec2(0), rawExtent - ivec2(1));
    float r = clamp((float(imageLoad(refRaw, qr).r) - p.black[0]) * p.invRange[0], 0.0, 1.0);
    float g1 = clamp((float(imageLoad(refRaw, qg1).r) - p.black[1]) * p.invRange[1], 0.0, 1.0);
    float g2 = clamp((float(imageLoad(refRaw, qg2).r) - p.black[2]) * p.invRange[2], 0.0, 1.0);
    float b = clamp((float(imageLoad(refRaw, qb).r) - p.black[3]) * p.invRange[3], 0.0, 1.0);
    // Same pre-LSC/WB classification as raw_demosaic sensor_clip_pack: per-phase
    // truth, G1/G2 independent (fixes the derived mask's collapsed bits 6).
    return (r >= p.clipThreshold ? 1u : 0u) | (g1 >= p.clipThreshold ? 2u : 0u) |
           (g2 >= p.clipThreshold ? 4u : 0u) | (b >= p.clipThreshold ? 8u : 0u);
}
// Colour (0 R, 1 G, 2 B) of the CFA site q.
int siteColour(ivec2 q) {
    ivec2 r = ivec2((p.siteChromaCfa == 1u || p.siteChromaCfa == 3u) ? 1 : 0,
                    (p.siteChromaCfa == 2u || p.siteChromaCfa == 3u) ? 1 : 0);
    ivec2 o = (q ^ r) & 1;
    return (o.x == 0 && o.y == 0) ? 0 : ((o.x == 1 && o.y == 1) ? 2 : 1);
}
vec3 loadMerged(ivec2 q) {
    vec3 v = imageLoad(mergedRgb, q).rgb;
    bvec3 invalid = bvec3(isnan(v.x) || isinf(v.x), isnan(v.y) || isinf(v.y), isnan(v.z) || isinf(v.z));
    return mix(v, vec3(0), invalid);
}
// Red / blue of a pixel v from the site-chroma sums: own value + (site mean - all-pixel mean) of the difference to green, then
// bounded by the nearest sites' differences.
vec3 siteFinish(vec3 v, vec3 gCell, vec2 dSite, vec2 wSite, vec2 dAll, float wAll, vec2 lo, vec2 hi) {
    // No similar site of a colour nearby (a thin line between sites): that colour keeps its value.
    const vec2 hasSite = step(vec2(1e-3 * wAll), wSite);
    const vec2 shift = hasSite * (dSite / max(wSite, vec2(1e-12)) - dAll / max(wAll, 1e-12));
    // The bound is widened by twice the noise of the difference, so noise alone is not clamped (that would copy green's
    // pixel noise into red / blue); every pixel has 1 to 4 sites of each colour within one pixel.
    const vec3 uq = v * gCell;
    const vec3 var3 = p.noiseSlope * max(v, vec3(0.0)) + p.noiseOffset;
    const vec2 margin = 2.0 * sqrt(vec2(gCell.r * gCell.r * var3.r, gCell.b * gCell.b * var3.b) + gCell.g * gCell.g * var3.g);
    const vec2 dq = clamp(vec2(uq.r - uq.g, uq.b - uq.g) + shift, lo - margin, hi + margin);
    return vec3(max((uq.g + dq.x) / gCell.r, 0.0), v.g, max((uq.g + dq.y) / gCell.b, 0.0));
}
// Site chroma neighbourhood: (merged rgb, re-estimated green) of the workgroup's 16 x 16 pixels +- 2, shared as fp16 pairs
// (lossless: both inputs are fp16). On Adreno a per-thread window in registers ran ~8x slower and fp32 shared tiles were
// bandwidth-bound.
const int TS = 20;
shared uvec2 sTile[TS * TS];   // packHalf2x16(r, g), packHalf2x16(b, re-estimated g)
shared vec2 sCell[64];         // per 2 x 2 cell of the workgroup: (fade-in for clipping, 1 if any re-estimated green differs)
const float TENT[3] = float[3](1.0, 2.0 / 3.0, 1.0 / 3.0);
vec4 tileAt(ivec2 t) {
    const uvec2 w = sTile[t.y * TS + t.x];
    return vec4(unpackHalf2x16(w.x), unpackHalf2x16(w.y));   // (r, g, b, re-estimated g)
}
// Site chroma of pixel q (tile position t), with the merged green (result a) and, when alt, with the re-estimated one
// (result b), in one pass over the 5 x 5 neighbourhood.
void siteChroma(ivec2 q, ivec2 t, bool alt, vec3 gCell, out vec3 resA, out vec3 resB) {
    const vec4 c0 = tileAt(t);
    const vec2 gq = vec2(c0.g, c0.w);   // the pixel's green: merged, re-estimated
    // Range scale on green (linear, pre lens shading): ~15% at mid grey, wider in the shadows where noise dominates.
    const vec2 sigma = 0.02 + 0.08 * sqrt(max(gq, vec2(0.0)));
    const vec2 inv = 0.125 / (sigma * sigma);   // 1 / (2 sigma^2) / 4: green similarity (1 - x / 4)^4 ~ exp(-x)
    // Sums for (red, blue): over the colour's own sites (dS, wS) and over every pixel (dA, wA); A = merged green, B = re-estimated.
    vec2 dSA = vec2(0.0), wSA = vec2(0.0), dAA = vec2(0.0), dSB = vec2(0.0), wSB = vec2(0.0), dAB = vec2(0.0);
    float wAA = 0.0, wAB = 0.0;
    vec2 loA = vec2(1.0e30), hiA = vec2(-1.0e30), loB = vec2(1.0e30), hiB = vec2(-1.0e30);   // site differences within one pixel
    // CFA colour of q + (dx, dy) from parity (the tile clamps at the image border, where this keeps the unclamped phase).
    const ivec2 rOff = ivec2((p.siteChromaCfa == 1u || p.siteChromaCfa == 3u) ? 1 : 0, (p.siteChromaCfa == 2u || p.siteChromaCfa == 3u) ? 1 : 0);
    const ivec2 ph = (q ^ rOff) & 1;
    for (int dy = -2; dy <= 2; ++dy) for (int dx = -2; dx <= 2; ++dx) {
        const vec4 w4 = tileAt(t + ivec2(dx, dy));
        const float tent = TENT[abs(dx)] * TENT[abs(dy)];
        const ivec2 o = (ph + ivec2(dx, dy)) & 1;
        const bool isR = o.x == 0 && o.y == 0, isB = o.x == 1 && o.y == 1, near = abs(dx) <= 1 && abs(dy) <= 1;
        const vec2 rb = vec2(w4.r * gCell.r, w4.b * gCell.b);
        {
            const float dg = w4.g - gq.x;
            const float r = max(1.0 - dg * dg * inv.x, 0.0), r2 = r * r;
            const float k = tent * r2 * r2;
            const vec2 diff = rb - w4.g * gCell.g;
            dAA += k * diff; wAA += k;
            if (isR) { dSA.x += k * diff.x; wSA.x += k; if (near) { loA.x = min(loA.x, diff.x); hiA.x = max(hiA.x, diff.x); } }
            if (isB) { dSA.y += k * diff.y; wSA.y += k; if (near) { loA.y = min(loA.y, diff.y); hiA.y = max(hiA.y, diff.y); } }
        }
        if (alt) {
            const float dg = w4.w - gq.y;
            const float r = max(1.0 - dg * dg * inv.y, 0.0), r2 = r * r;
            const float k = tent * r2 * r2;
            const vec2 diff = rb - w4.w * gCell.g;
            dAB += k * diff; wAB += k;
            if (isR) { dSB.x += k * diff.x; wSB.x += k; if (near) { loB.x = min(loB.x, diff.x); hiB.x = max(hiB.x, diff.x); } }
            if (isB) { dSB.y += k * diff.y; wSB.y += k; if (near) { loB.y = min(loB.y, diff.y); hiB.y = max(hiB.y, diff.y); } }
        }
    }
    resA = siteFinish(c0.rgb, gCell, dSA, wSA, dAA, wAA, loA, hiA);
    resB = alt ? siteFinish(vec3(c0.r, c0.w, c0.b), gCell, dSB, wSB, dAB, wAB, loB, hiB) : resA;
}
// White-balanced colour relative to green.
float colourAmount(vec3 v, vec3 gCell) {
    const vec3 u = v * gCell;
    return (abs(u.r - u.g) + abs(u.b - u.g)) / (u.g + 1e-3);
}
void main() {
    // One pixel per invocation; the invocation at a cell's top-left pixel also writes the cell's clip state.
    const ivec2 q = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 cell = q >> 1;
    const ivec2 l = ivec2(gl_LocalInvocationID.xy);
    const bool siteOn = p.siteChromaCfa <= 3u;
    // Site chroma (SiteChromaParams). The smooth white-balanced colour difference of red / blue to green is measured twice
    // over the 5 x 5 neighbourhood with the same weights (tent x green similarity, so a site across an edge lends no
    // colour): from the colour's own CFA sites only, and from every pixel. Red / blue keep their own value and take the
    // difference of the two: the false-colour bands, which live in the values interpolated between sites, are replaced
    // by the sites' colour, while the pixel's own detail and noise stay (rebuilding the channel as green + difference would
    // copy green's pixel noise into it). The result is bounded by the nearest sites' differences. This runs with the merged
    // green and with prepare_green's re-estimated one (which differs only where the merge kept few frames); the less
    // coloured of the two results is kept, as false colour only adds colour. Faded out where the cell's 6 x 6
    // neighbourhood nears clipping (the difference to a clipped green is not the colour).
    const ivec2 tileOrigin = ivec2(gl_WorkGroupID.xy) * 16 - 2;
    if (siteOn) {   // uniform: every invocation reaches the barriers
        const ivec2 maxQ = ivec2(int(p.width), int(p.height)) - 1;
        for (int i = int(gl_LocalInvocationIndex); i < TS * TS; i += 256) {
            const ivec2 g = clamp(tileOrigin + ivec2(i % TS, i / TS), ivec2(0), maxQ);
            const vec3 v = loadMerged(g);
            const float ga = imageLoad(greenAlt, g).r;
            sTile[i] = uvec2(packHalf2x16(v.rg), packHalf2x16(vec2(v.b, isnan(ga) || isinf(ga) ? v.g : ga)));
        }
        barrier();
        if ((l.x & 1) == 0 && (l.y & 1) == 0) {
            float peak = 0.0;
            bool altDiffers = false;
            for (int j = -2; j < 4; ++j) for (int i = -2; i < 4; ++i) {
                const vec4 w4 = tileAt(l + 2 + ivec2(i, j));
                peak = max(peak, max(w4.r, max(w4.g, w4.b)));
                altDiffers = altDiffers || w4.w != w4.g;
            }
            sCell[(l.y >> 1) * 8 + (l.x >> 1)] = vec2(1.0 - smoothstep(0.85, 0.95, peak), altDiffers ? 1.0 : 0.0);
        }
        barrier();
    }
    if (q.x >= int(p.width) || q.y >= int(p.height)) return;
    if ((q.x & 1) == 0 && (q.y & 1) == 0 && all(lessThan(cell, imageSize(clipState)))) {
        uint mask = 0u;
        for (int y = 0; y < 2; ++y) for (int x = 0; x < 2; ++x) {
            const ivec2 c = q + ivec2(x, y);
            if (c.x >= int(p.width) || c.y >= int(p.height)) continue;
            vec3 v = imageLoad(mergedRgb, c).rgb;
            bvec3 invalid = bvec3(isnan(v.x) || isinf(v.x), isnan(v.y) || isinf(v.y), isnan(v.z) || isinf(v.z));
            if (invalid.r || v.r >= .995) mask |= 1u;
            if (invalid.g || v.g >= .995) mask |= 6u;
            if (invalid.b || v.b >= .995) mask |= 8u;
        }
        // 1A: OR reference sensor truth when geometry matches (scale 1x).
        // Conservative: clipped if either merged-derived or sensor says so.
        // Sensor-only clips diluted below .995 by the merge are recovered here.
        if (p.useSensorClip != 0u && p.refWidth == p.width && p.refHeight == p.height) mask |= sensorClipForCell(cell);
        imageStore(clipState, cell, uvec4(mask, 0, 0, 0));
    }
    vec3 v = loadMerged(q);
    if (siteOn) {
        const vec2 c = sCell[(l.y >> 1) * 8 + (l.x >> 1)];
        if (c.x > 0.0) {
            const vec3 gCell = gainAt(cell * 2) * vec3(p.wbR, 1.0, p.wbB);
            vec3 a, b;
            siteChroma(q, l + 2, c.y > 0.5, gCell, a, b);
            v = mix(v, colourAmount(b, gCell) < colourAmount(a, gCell) ? b : a, c.x);
        }
    }
    imageStore(outRgb, q, vec4(clamp(v, 0.0, 1.0) * gainAt(q), 1));
}
