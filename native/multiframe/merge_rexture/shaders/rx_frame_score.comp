#version 450
#extension GL_GOOGLE_include_directive : enable
// Rexture base selection: cheap per-frame score, evaluated at the shutter press for the frames of the candidate window.
// Quarter-resolution green plane q (mean of the 8 green samples of each 4 x 4 raw block); sharp = mean over unclipped
// positions of (Laplacian(q)^2 - 20 * expected noise variance of q), expected variance (alpha max(q, 0) + beta) / 8;
// sat = share of quarter-resolution positions whose 4 x 4 block holds a clipped raw sample (>= white - 3).
// One workgroup = 16 x 16 quarter-resolution positions; it writes one partial
// (sum of lap^2 - 20 var over ok positions, number of ok positions, number of clipped positions, number of positions) to
// partials[frameSlot * workgroups + wg]; the host adds them in double precision.
#include "rx_common.glsl"

layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 0, r16ui) readonly uniform uimage2D rawU16;
layout(set = 0, binding = 1, std430) buffer Partials { vec4 partials[]; };
layout(push_constant) uniform P {
    vec4 black;
    float white;
    int w, h, cfa;
    float alpha, beta;
    int frameSlot, workgroups;
} p;

shared vec4 red[256];
const float CLIP_MARGIN = 3.0;

// (q, clipped) of quarter-resolution position t
vec2 quarter(ivec2 t) {
    float s = 0.0, clipped = 0.0;
    for (int dy = 0; dy < 4; ++dy)
        for (int dx = 0; dx < 4; ++dx) {
            ivec2 q = t * 4 + ivec2(dx, dy);
            float raw = float(imageLoad(rawU16, q).x);
            if (raw >= p.white - CLIP_MARGIN) clipped = 1.0;
            if (rxChannel(q, p.cfa) == 1) s += rxNormFromRaw(raw, q, p.black, p.white);
        }
    return vec2(0.125 * s, clipped);
}

void main() {
    const ivec2 qn = ivec2(p.w / 4, p.h / 4);
    const ivec2 t = ivec2(gl_GlobalInvocationID.xy);
    const int tid = int(gl_LocalInvocationIndex);
    vec4 v = vec4(0.0);
    if (t.x < qn.x && t.y < qn.y) {
        vec2 c = quarter(t);
        v.z = c.y;
        v.w = 1.0;
        if (t.x >= 1 && t.y >= 1 && t.x < qn.x - 1 && t.y < qn.y - 1) {
            vec2 n = quarter(t + ivec2(0, -1)), s = quarter(t + ivec2(0, 1));
            vec2 wv = quarter(t + ivec2(-1, 0)), e = quarter(t + ivec2(1, 0));
            if (c.y + n.y + s.y + wv.y + e.y == 0.0) {
                float lap = 4.0 * c.x - n.x - s.x - wv.x - e.x;
                float var = (p.alpha * max(c.x, 0.0) + p.beta) / 8.0;
                v.x = lap * lap - 20.0 * var;
                v.y = 1.0;
            }
        }
    }
    red[tid] = v;
    barrier();
    for (int st = 128; st > 0; st >>= 1) {
        if (tid < st) red[tid] += red[tid + st];
        barrier();
    }
    if (tid == 0) {
        int wgIndex = int(gl_WorkGroupID.y) * int(gl_NumWorkGroups.x) + int(gl_WorkGroupID.x);
        partials[p.frameSlot * p.workgroups + wgIndex] = red[0];
    }
}
