#version 450
#extension GL_GOOGLE_include_directive : enable
// Rexture final pass.
//   finalize(p): the base's own 3 x 3 samples join the running sums (same kernel, red / blue 1.2x wider, and the same
//     per-frame weight normalisation as the companions);
//     neff = (sum w)^2 / sum_frames W^2 per colour, mass = sum w / (support + 1),
//     conf = min over colours of smoothstep(1, 3, neff) * smoothstep(.001, .03, mass),
//     out = rcd + (merged - rcd) * conf, rcd = the bounded RCD demosaic of the base.
//   m = the output's noise variance relative to one frame: the RCD share (1 - conf)^2 plus the merged share
//     conf^2 / neff. It is written as the mean per 4 x 4 pixel cell (the per-site alternation of red / green / blue
//     averages out) for rx_lowcov_eaw, which evens out the grain where few frames were merged.
// One workgroup = 16 x 16 pixels = 4 x 4 cells.
#include "rx_common.glsl"

layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 0, r16ui) readonly uniform uimage2D rawU16;      // the base frame
layout(set = 0, binding = 1, rgba32f) readonly uniform image2D covI;
layout(set = 0, binding = 2, rgba32f) readonly uniform image2D accA;
layout(set = 0, binding = 3, rg32f) readonly uniform image2D accB;
layout(set = 0, binding = 4, rgba16f) readonly uniform image2D accC;
layout(set = 0, binding = 5, r32f) readonly uniform image2D supportI;
layout(set = 0, binding = 6, rgba16f) readonly uniform image2D rcdI;
layout(set = 0, binding = 7, rgba16f) writeonly uniform image2D outI;
layout(set = 0, binding = 8, rgba32f) writeonly uniform image2D dbgOutI;   // (final rgb, neff)       verification only
layout(set = 0, binding = 9, rgba32f) writeonly uniform image2D dbgPreI;   // (pre-grain rgb, conf)   verification only
layout(set = 0, binding = 10, r32f) writeonly uniform image2D mI;          // m per 4 x 4 pixel cell
layout(push_constant) uniform P {
    vec4 black;
    float white;
    int w, h, cfa, debug;
} p;

const float RB_WIDEN = 1.2;
const float NEFF_LO = 1.0, NEFF_HI = 3.0, MASS_LO = 0.001, MASS_HI = 0.03;
const float FRAME_NORM_FLOOR = 0.1;   // as in rx_accumulate
shared float sM[256];                 // m of the workgroup's pixels (-1 outside the image)

struct Fin { vec3 rgb; float conf; float neff; };

Fin finalizeAt(ivec2 q0) {
    const ivec2 size = ivec2(p.w, p.h);
    vec3 ca, cb, cc4, cd;
    vec2 cf;
    RX_COV_NEIGHBOURS(covI, q0, ca, cb, cc4, cd, cf);
    const vec3 qi = rxCovInverse(ca, cb, cc4, cd, cf);
    vec3 rs = vec3(0.0), rw = vec3(0.0);
    for (int dy = -1; dy <= 1; ++dy)
        for (int dx = -1; dx <= 1; ++dx) {
            ivec2 q = q0 + ivec2(dx, dy);
            if (any(lessThan(q, ivec2(0))) || any(greaterThanEqual(q, size))) continue;
            int cc = rxChannel(q, p.cfa);
            float s = cc == 1 ? 1.0 : 1.0 / (RB_WIDEN * RB_WIDEN);
            float z = max(0.0, s * (qi.x * float(dx * dx) + 2.0 * qi.y * float(dx * dy) + qi.z * float(dy * dy)));
            float ww = exp(-0.5 * z);
            float v = rxNormFromRaw(float(imageLoad(rawU16, q).x), q, p.black, p.white);
            rs[cc] += v * ww;
            rw[cc] += ww;
        }
    {   // the base frame's weight per colour is 1, like every companion's at full robustness
        const vec3 sc = vec3(1.0) / max(rw, vec3(FRAME_NORM_FLOOR));
        rs *= sc;
        rw *= sc;
    }
    vec4 a = imageLoad(accA, q0);
    vec2 bw = imageLoad(accB, q0).xy;
    vec3 accSq = imageLoad(accC, q0).xyz;
    vec3 total = vec3(a.w, bw) + rw;
    vec3 square = accSq + rw * rw;
    vec3 neff = total * total / max(square, vec3(1e-20));
    float loc = imageLoad(supportI, clamp(q0 / 2, ivec2(0), imageSize(supportI) - 1)).x;
    vec3 mass = total / max(loc + 1.0, 1.0);
    vec3 cert = vec3(smoothstep(NEFF_LO, NEFF_HI, neff.x) * smoothstep(MASS_LO, MASS_HI, mass.x),
                     smoothstep(NEFF_LO, NEFF_HI, neff.y) * smoothstep(MASS_LO, MASS_HI, mass.y),
                     smoothstep(NEFF_LO, NEFF_HI, neff.z) * smoothstep(MASS_LO, MASS_HI, mass.z));
    float conf = min(cert.x, min(cert.y, cert.z));
    vec3 merged = (a.xyz + rs) / max(total, vec3(1e-20));
    vec3 base = imageLoad(rcdI, q0).xyz;
    Fin f;
    f.rgb = base + (merged - base) * conf;
    // A non-finite value (degenerate weights, a bad sample) takes the base's value, or 0: one bad pixel must not reach the
    // whole-image statistics of the render (auto sharpening, exposure, gain map), which would spoil the entire picture.
    for (int c = 0; c < 3; ++c)
        if (isnan(f.rgb[c]) || isinf(f.rgb[c])) f.rgb[c] = (isnan(base[c]) || isinf(base[c])) ? 0.0 : base[c];
    if (isnan(conf)) conf = 0.0;
    f.conf = conf;
    f.neff = min(neff.x, min(neff.y, neff.z));
    return f;
}

void main() {
    const ivec2 t2 = ivec2(gl_LocalInvocationID.xy);
    const int tid = t2.y * 16 + t2.x;
    const ivec2 o0 = ivec2(gl_WorkGroupID.xy) * 16;
    const ivec2 pos = o0 + t2;
    if (pos.x < p.w && pos.y < p.h) {
        Fin f = finalizeAt(pos);
        imageStore(outI, pos, vec4(f.rgb, 1.0));
        sM[tid] = (1.0 - f.conf) * (1.0 - f.conf) + f.conf * f.conf / max(f.neff, 1.0);
        if (p.debug != 0) {
            imageStore(dbgOutI, pos, vec4(f.rgb, f.neff));
            imageStore(dbgPreI, pos, vec4(f.rgb, f.conf));
        }
    } else {
        sM[tid] = -1.0;
    }
    barrier();
    if (tid < 16) {
        const ivec2 cc = ivec2(tid & 3, tid >> 2);
        float sum = 0.0, cnt = 0.0;
        for (int j = 0; j < 4; ++j)
            for (int i = 0; i < 4; ++i) {
                float v = sM[(cc.y * 4 + j) * 16 + cc.x * 4 + i];
                if (v >= 0.0) {
                    sum += v;
                    cnt += 1.0;
                }
            }
        if (cnt > 0.0) imageStore(mI, o0 / 4 + cc, vec4(sum / cnt));
    }
}
