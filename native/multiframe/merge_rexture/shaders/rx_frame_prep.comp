#version 450
#extension GL_GOOGLE_include_directive : enable
// Rexture frame preparation: the one pass that reads a raw frame (base or companion).
// One workgroup = a 16 x 16 tile of half-resolution guide positions = a 32 x 32 raw block. From a single 43 x 43
// normalised raw tile in shared memory it writes
//   l3   alignment guide, full resolution: normalised raw -> separable [1 4 6 4 1]/16 (local5, edge clamp)
//   l2   VALID Gaussian (sigma 1, 9 taps) of l3, decimated by 2
//   mean / var   3x3 mean and variance (edge clamp) of the linear half-resolution R / mean-G / B guide
//   tensor (base only)   2x2 structure tensor sums of the GAT grey (sa, sb, sd), before the Gaussian integration
// Starts from raw_normalize, alignment_local5, pyramid_gaussian, robust_guide, robust_stats, kernel_estimate (grey, gradient).
#include "rx_tables.glsl"
#include "rx_common.glsl"

#ifndef RX_PG
#define RX_PG 16          // guide positions per workgroup edge (workgroup = RX_PG x RX_PG threads)
#endif
layout(local_size_x = RX_PG, local_size_y = RX_PG) in;
layout(set = 0, binding = 0, r16ui) readonly uniform uimage2D rawU16;
layout(set = 0, binding = 1, r32f) writeonly uniform image2D l3Out;
layout(set = 0, binding = 2, r32f) writeonly uniform image2D l2Out;
layout(set = 0, binding = 3, rgba32f) writeonly uniform image2D meanOut;
layout(set = 0, binding = 4, rgba32f) writeonly uniform image2D varOut;
layout(set = 0, binding = 5, rgba32f) writeonly uniform image2D tensorOut;
layout(push_constant) uniform P {
    vec4 black;      // per raster phase (y & 1) * 2 + (x & 1)
    float white;
    int w, h;        // raw
    int l2w, l2h;    // VALID l2 extent
    int cfa;
    int isBase;      // 1: also write the structure tensor
    float alpha, beta;
    int skip;        // (host-side profiling knob, unused here)
    float gain;      // reference exposure / this frame's exposure (1 for the base and equal-exposure bursts)
}
p;

const int PG = RX_PG, NT = RX_PG * RX_PG;
const int RAW_T = 2 * PG + 11, L3_T = 2 * PG + 7, G_T = PG + 2;   // raw tile (local5 + Gaussian apron), l3 tile, guide tile
shared float sA[RAW_T * RAW_T];   // normalised raw tile, later the l3 tile (39 x 39)
shared float sB[RAW_T * L3_T];    // horizontal local5, later the vertical Gaussian pass (PG x L3_T)
shared vec3 sG[G_T * G_T];        // guide R, G, B at guide positions g0 - 1 .. g0 + 16
shared float sGrey[G_T * G_T];    // GAT grey at the same positions (base only)

float gat(float x) {
    float a = p.alpha;
    return (2.0 / a) * sqrt(max(0.0, a * x + 0.375 * a * a + p.beta));
}

void main() {
    const ivec2 tid2 = ivec2(gl_LocalInvocationID.xy);
    const int tid = tid2.y * PG + tid2.x;
    const ivec2 g0 = ivec2(gl_WorkGroupID.xy) * PG;      // first guide position of the tile
    const ivec2 gSize = ivec2(p.w / 2, p.h / 2);
    const ivec2 rawSize = ivec2(p.w, p.h);
    const ivec2 rt0 = 2 * g0 - 2;                         // raw coordinate of tile (0, 0)

    // (A) normalised raw tile
    for (int y = tid2.y; y < RAW_T; y += PG)
        for (int x = tid2.x; x < RAW_T; x += PG) {
            ivec2 qc = clamp(rt0 + ivec2(x, y), ivec2(0), rawSize - 1);
            sA[y * RAW_T + x] = p.gain * rxNormFromRaw(float(imageLoad(rawU16, qc).x), qc, p.black, p.white);
        }
    barrier();

    // (B) guide planes and grey from the raw tile; horizontal local5 into sB
    const ivec2 red = rxRedOffset(p.cfa);
    const ivec2 blue = ivec2(1) - red;
    for (int gy = tid2.y; gy < G_T; gy += PG)
      for (int gx = tid2.x; gx < G_T; gx += PG) {
        const int i = gy * G_T + gx;
        ivec2 gq = clamp(g0 - 1 + ivec2(gx, gy), ivec2(0), gSize - 1);
        ivec2 t = 2 * gq - rt0;                           // tile coordinate of the quad's (0, 0) sample
        float r = sA[(t.y + red.y) * RAW_T + t.x + red.x];
        float b = sA[(t.y + blue.y) * RAW_T + t.x + blue.x];
        float g1 = sA[(t.y + red.y) * RAW_T + t.x + blue.x];
        float g2 = sA[(t.y + blue.y) * RAW_T + t.x + red.x];
        sG[i] = vec3(r, 0.5 * (g1 + g2), b);
        if (p.isBase != 0) {
            float s00 = sA[t.y * RAW_T + t.x], s01 = sA[t.y * RAW_T + t.x + 1];
            float s10 = sA[(t.y + 1) * RAW_T + t.x], s11 = sA[(t.y + 1) * RAW_T + t.x + 1];
            sGrey[i] = 0.25 * (gat(s00) + gat(s01) + gat(s10) + gat(s11));
        }
    }
    for (int r = tid2.y; r < RAW_T; r += PG)
        for (int c = tid2.x; c < L3_T; c += PG) {
            const int o = r * RAW_T + c;
            sB[r * L3_T + c] = (sA[o] + 4.0 * sA[o + 1] + 6.0 * sA[o + 2] + 4.0 * sA[o + 3] + sA[o + 4]) * 0.0625;
        }
    barrier();

    // (C) vertical local5: the l3 tile (overwrites sA; its last read was above)
    for (int r = tid2.y; r < L3_T; r += PG)
        for (int c = tid2.x; c < L3_T; c += PG)
            sA[r * L3_T + c] = (sB[r * L3_T + c] + 4.0 * sB[(r + 1) * L3_T + c] + 6.0 * sB[(r + 2) * L3_T + c] +
                                4.0 * sB[(r + 3) * L3_T + c] + sB[(r + 4) * L3_T + c]) * 0.0625;
    barrier();

    // (D) l3 store (the 32 x 32 block of this tile) and the vertical Gaussian pass of l2
    for (int dy = 0; dy < 2 * PG; dy += PG)
        for (int dx = 0; dx < 2 * PG; dx += PG) {
            ivec2 q = 2 * g0 + tid2 + ivec2(dx, dy);
            if (q.x < p.w && q.y < p.h) imageStore(l3Out, q, vec4(sA[(tid2.y + dy) * L3_T + tid2.x + dx]));
        }
    for (int c = tid2.x; c < L3_T; c += PG) {   // vertical Gaussian pass: one row of the PG x L3_T tile per thread row
        float acc = 0.0;
        for (int a = 0; a < 9; ++a) acc += RX_K2[a] * sA[(2 * tid2.y + a) * L3_T + c];
        sB[tid2.y * L3_T + c] = acc;
    }
    barrier();

    // (E) horizontal Gaussian pass, mean / variance, tensor
    const ivec2 gq = g0 + tid2;
    if (gq.x < p.l2w && gq.y < p.l2h) {
        float acc = 0.0;
        for (int b = 0; b < 9; ++b) acc += RX_K2[b] * sB[tid2.y * L3_T + 2 * tid2.x + b];
        imageStore(l2Out, gq, vec4(acc));
    }
    if (gq.x < gSize.x && gq.y < gSize.y) {
        vec3 s = vec3(0.0), ss = vec3(0.0);
        for (int dy = 0; dy < 3; ++dy)
            for (int dx = 0; dx < 3; ++dx) {
                vec3 v = sG[(tid2.y + dy) * G_T + tid2.x + dx];
                s += v;
                ss += v * v;
            }
        vec3 m = s / 9.0;
        imageStore(meanOut, gq, vec4(m, 0.0));
        imageStore(varOut, gq, vec4(ss / 9.0 - m * m, 0.0));
        if (p.isBase != 0) {
            // tensor sums over z = q - 1 + {0, 1}^2 (zero outside the valid gradient range)
            vec3 t[4];
            for (int k = 0; k < 4; ++k) {
                ivec2 z = gq - 1 + ivec2(k & 1, k >> 1);    // z = (x - 1, y - 1), (x, y - 1), (x - 1, y), (x, y)
                vec3 e = vec3(0.0);
                if (z.x >= 0 && z.y >= 0 && z.x < gSize.x - 1 && z.y < gSize.y - 1) {
                    ivec2 l = z - (g0 - 1);                  // index into the 18 x 18 grey tile
                    float A = sGrey[l.y * G_T + l.x], B = sGrey[l.y * G_T + l.x + 1];
                    float C = sGrey[(l.y + 1) * G_T + l.x], D = sGrey[(l.y + 1) * G_T + l.x + 1];
                    float gx = 0.25 * (-A + B - C + D), gy = 0.25 * (-A - B + C + D);
                    e = vec3(gx * gx, gx * gy, gy * gy);
                }
                t[k] = e;
            }
            imageStore(tensorOut, gq, vec4(t[0] + t[1] + t[2] + t[3], 0.0));
        }
    }
}
