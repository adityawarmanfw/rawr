#version 450
#extension GL_GOOGLE_include_directive : enable
// Rexture grain evening where the merge kept few frames, in strips of rows (scratch memory independent of the image
// height). Three levels of an edge-avoiding a-trous filter (5 x 5 B3 taps at stride 1, 2, 4; range weight on green
// and on the colour difference (R - G, B - G), noise scaled by m, the output's noise variance relative to one frame) give
// a smooth x3; the result is x3 + g (x0 - x3), g = clamp(sqrt(TARGET / m), GMIN, 1): every band finer than x3 shrinks by
// the same factor, so the grain keeps its size and only gets weaker. Pixels with m <= TARGET are not written.
//   op 0: x1 = A1(x0)    op 1: x2 = A2(x1)    op 3: save original rows    op 2: out = x3 + g (x0 - x3), x3 = A4(x2), in place.
// A strip core [r0, r1) needs x0 rows +-14, x1 rows +-12, x2 rows +-8 (image edges clamp, like the whole-image filter).
// In-place output would destroy the next strip's top halo, so op 3 (after op 1, before op 2) saves the original last 14 rows
// of the core into haloI; op 0 of the next strip reads rows above its core from there.
// m comes from rx_finalize on a grid of 4 x 4 pixel cells (cell mean), sampled bilinearly. A workgroup whose 24 px
// surroundings hold no cell with m > TARGET skips ops 0 / 1 (and the write of op 2): nothing downstream can use them.
// The 24 px margin covers the 14 px reach of the filter chain plus the bilinear support of m.
layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 0, rgba16f) uniform image2D x0I;      // the merge output (linear_output)
layout(set = 0, binding = 1, rgba16f) uniform image2D haloI;    // original rows [r0 - 14, r0) of the image
layout(set = 0, binding = 2, rgba16f) uniform image2D x1I;      // strip: image rows [a1, ...)
layout(set = 0, binding = 3, rgba16f) uniform image2D x2I;      // strip: image rows [a2, ...)
layout(set = 0, binding = 4, r32f) readonly uniform image2D mI; // m per 4 x 4 cell
layout(push_constant) uniform P {
    int op, w, h;
    int r0, r1;           // strip core rows
    int y0, rows;         // image rows computed by this dispatch
    int a1, a2;           // first image row held by x1I, x2I
    float alpha, beta;    // single-frame noise model of the merge
    float frames;         // frames in the burst
} p;

const int HALO = 14;
// Tuned on real dark-scene bursts against HDR+ Quality: the fallback is lowered to the grain level of the merged areas
// next to it and never below 0.3 of its amplitude. TARGET 0.25 (about a 4 frame merge): a cleaner merge than that is left alone, so faint wall-like
// structure in a 6 to 10 frame merge is not cut together with its noise (0.15 cut the 8 to 50 px bands of a dark wall to 0.4 of the reference merge).
const float TARGET = 0.25;             // output noise variance relative to one frame that is left alone
const float GMIN = 0.3;                // lowest amplitude gain of the bands finer than x3
// Colour is shrunk further out, down to m = TARGET_C (about 12 frames): its amplitude then stays level from 4 to 12 frames instead of
// rising when the pass switches off at TARGET and falling again with more frames.
const float TARGET_C = 0.08;
const float SNR_LO = 15.0, SNR_HI = 45.0;
const float SINGLE_SNR_LO = 15.0, SINGLE_SNR_HI = 28.0, SINGLE_M_LO = 0.85, SINGLE_M_HI = 0.97;
const float KC = 2.0;                  // colour range weight relative to the luma one
// Range noise factor of the three levels. With few frames (4 or fewer) (1.0, 0.6, 0.4): the grain is the merge's own and the pass evens
// it. From 8 frames on (0.3, 0.18, 0.12): the areas still below TARGET are then ones the robustness test rejected frames from
// (moving water, foliage), and with the old factors the range weight read their real ripples (a few noise sigmas high) as grain
// and erased the 0.2-0.5 c/px bands (kept 0.50-0.31 of the base frame; 0.76-0.55 now, PhotonCamera 0.77-0.57). Flat noisy areas
// still smooth (flat noise +1-3% on the 10 to 20 frame test bursts). Linear in between. Only where some frames were merged (m below M_LO):
// where nearly one frame is left (m above M_HI: a moving crowd) the single-frame grain stays smoothed as before, or it shows as speckle.
const float M_LO = 0.2, M_HI = 0.45;
const float FK_FEW[3] = float[3](1.0, 0.6, 0.4), FK_MANY[3] = float[3](0.3, 0.18, 0.12);
float fk(int level, float m) { return mix(FK_FEW[level], FK_MANY[level], smoothstep(4.0, 8.0, p.frames) * (1.0 - smoothstep(M_LO, M_HI, m))); }
const float B3[5] = float[5](1.0 / 16.0, 4.0 / 16.0, 6.0 / 16.0, 4.0 / 16.0, 1.0 / 16.0);
shared uint sActive;

float mAt(ivec2 q) {
    ivec2 n = imageSize(mI);
    vec2 u = (vec2(q) + 0.5) / 4.0 - 0.5;
    vec2 b = floor(u), f = u - b;
    ivec2 lo = clamp(ivec2(b), ivec2(0), n - 1), hi = clamp(ivec2(b) + 1, ivec2(0), n - 1);
    float a = mix(imageLoad(mI, lo).x, imageLoad(mI, ivec2(hi.x, lo.y)).x, f.x);
    float c = mix(imageLoad(mI, ivec2(lo.x, hi.y)).x, imageLoad(mI, hi).x, f.x);
    return mix(a, c, f.y);
}

// q is inside the image
vec3 fetch(int level, ivec2 q) {
    if (level == 0) {
        if (q.y < p.r0) return imageLoad(haloI, ivec2(q.x, q.y - (p.r0 - HALO))).rgb;
        return imageLoad(x0I, q).rgb;
    }
    if (level == 1) return imageLoad(x1I, ivec2(q.x, q.y - p.a1)).rgb;
    return imageLoad(x2I, ivec2(q.x, q.y - p.a2)).rgb;
}

// The 16 x 16 workgroup's (16 + 4 stride)^2 neighbourhood of one level, read once into shared memory: the 25 taps of every pixel come from there instead of
// 25 image reads each. Rows past the last row this dispatch computes are never tapped and are not read (they may lie outside the strip's scratch rows).
shared vec3 sTile[32 * 32];

void loadTile(int level, int stride, ivec2 wo, int tid) {
    const int T = 16 + 4 * stride;
    const int lastRow = p.y0 + p.rows - 1 + 2 * stride;
    for (int i = tid; i < T * T; i += 256) {
        ivec2 t = wo + ivec2(i % T, i / T) - 2 * stride;
        vec3 v = vec3(0.0);
        if (t.y <= lastRow) {
            t = clamp(t, ivec2(0), ivec2(p.w - 1, p.h - 1));
            v = fetch(level, t);
        }
        sTile[i] = v;
    }
}

// l: the pixel's position in the workgroup
vec3 atrous(int level, ivec2 l, int stride, float m) {
    const int T = 16 + 4 * stride;
    const vec3 c = sTile[(l.y + 2 * stride) * T + l.x + 2 * stride];
    const float var = 9.0 * (p.alpha * max(c.g, 0.0) + p.beta) * m;
    // Luma range factor follows the frame count (fk); the colour range keeps the few-frame factor, or the colour noise of
    // moving crowds (single frames) survives as coloured specks.
    const float r2 = max(var * fk(level, m) * fk(level, m), 1e-12), r2c = max(var * FK_FEW[level] * FK_FEW[level] * KC, 1e-12);
    vec3 num = vec3(0.0);
    float den = 0.0;
    for (int j = 0; j < 5; ++j)
        for (int i = 0; i < 5; ++i) {
            vec3 v = sTile[(l.y + stride * j) * T + l.x + stride * i];
            float dg = v.g - c.g;
            vec2 dc = (v.rb - v.g) - (c.rb - c.g);
            float k = B3[i] * B3[j] * exp(-dg * dg / (2.0 * r2) - dot(dc, dc) / (2.0 * r2c));
            num += k * v;
            den += k;
        }
    return num / den;
}

void main() {
    const int tid = int(gl_LocalInvocationIndex);
    const ivec2 q = ivec2(int(gl_GlobalInvocationID.x), p.y0 + int(gl_GlobalInvocationID.y));
    const bool inside = q.x < p.w && int(gl_GlobalInvocationID.y) < p.rows;
    if (p.op == 3) {   // rows [r1 - 14, r1) of the original image for the next strip
        if (inside) imageStore(haloI, ivec2(q.x, q.y - (p.r1 - HALO)), imageLoad(x0I, q));
        return;
    }
    const ivec2 wo = ivec2(int(gl_WorkGroupID.x) * 16, p.y0 + int(gl_WorkGroupID.y) * 16);
    {   // skip workgroups whose surroundings hold nothing to fix
        if (tid == 0) sActive = 0u;
        barrier();
        const ivec2 c0 = ivec2((wo.x - 24) >> 2, (wo.y - 24) >> 2);   // 16 x 16 cells = [wo - 24, wo + 40)
        {
            ivec2 c = clamp(c0 + ivec2(tid % 16, tid / 16), ivec2(0), imageSize(mI) - 1);
            if (imageLoad(mI, c).x > TARGET_C) atomicOr(sActive, 1u);
        }
        barrier();
        if (sActive == 0u) return;
    }
    const int stride = p.op == 0 ? 1 : (p.op == 1 ? 2 : 4);
    loadTile(p.op, stride, wo, tid);   // level 0 for op 0, 1 for op 1, 2 for op 2
    barrier();
    if (!inside) return;
    const ivec2 lid = ivec2(gl_LocalInvocationID.xy);
    const float m = mAt(q);
    if (p.op == 0) {
        imageStore(x1I, ivec2(q.x, q.y - p.a1), vec4(atrous(0, lid, 1, m), 1.0));
    } else if (p.op == 1) {
        imageStore(x2I, ivec2(q.x, q.y - p.a2), vec4(atrous(1, lid, 2, m), 1.0));
    } else {
        const float g = clamp(sqrt(TARGET / max(m, 1e-6)), GMIN, 1.0);
        const float gc = min(g * g, clamp(sqrt(TARGET_C / max(m, 1e-6)), 0.0, 1.0));   // colour gain
        if (gc >= 1.0) return;
        const vec3 x3 = atrous(2, lid, 4, m);
        const vec3 x0 = imageLoad(x0I, q).rgb;
        // Band-dependent shrink, coarse -> fine. Luma (green): the 4 px band by g, the 2 px and the finest band by sqrt(g), so most of the fine grain
        // and the low-contrast texture survive and the coarse noise (the blotches) is what gets weaker. Colour (R - G, B - G) is shrunk harder, by min(g^2, sqrt(TARGET_C / m)) on
        // every band: colour noise is far less visible than luma noise, and unshrunk fine colour noise shows as coloured specks along edges.
        const vec3 x1 = fetch(1, q);
        const vec3 x2 = fetch(2, q);
        const vec3 b3 = x2 - x3, b2 = x1 - x2, b1 = x0 - x1;
        const float snr = max(x3.g, 1e-6) / sqrt(max((p.alpha * max(x3.g, 0.0) + p.beta) * max(m, 1e-6), 1e-20));   // output SNR of the pixel
        const float st = smoothstep(SNR_LO, SNR_HI, snr);   // 0 = noisy (shrink the fine bands like the 4 px band), 1 = clean (keep them)
        // A clean pixel that kept a single frame (moving subject, m about 1): nothing was merged there and its single-frame noise is low, so the grain pass is
        // skipped: it would only take texture off the demosaic.
        const float snr1 = max(x3.g, 1e-6) / sqrt(max(p.alpha * max(x3.g, 0.0) + p.beta, 1e-20));   // single-frame SNR
        const float keep = smoothstep(SINGLE_SNR_LO, SINGLE_SNR_HI, snr1) * smoothstep(SINGLE_M_LO, SINGLE_M_HI, m);
        const float yl = mix(x3.g + g * b3.g + pow(g, 1.0 - 0.5 * st) * b2.g + pow(g, 1.0 - st) * b1.g, x0.g, keep);
        const vec2 ch = (x3.rb - x3.g) + gc * ((b3.rb - b3.g) + (b2.rb - b2.g) + (b1.rb - b1.g));
        imageStore(x0I, q, vec4(ch.x + yl, yl, ch.y + yl, 1.0));
    }
}
