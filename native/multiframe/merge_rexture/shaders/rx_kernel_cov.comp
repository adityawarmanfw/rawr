#version 450
#extension GL_GOOGLE_include_directive : enable
// Rexture base pass: anisotropic kernel covariance (cxx, cxy, cyy), raw-pixel units, at half resolution.
// Inputs: the integrated tensor (sa, sb, sd) and the local (2x2, un-integrated) tensor. Constants are the reference
// configuration: k_detail .20, k_denoise 2, d_threshold .71, d_transition 1, k_stretch 4, k_shrink 2, detail_floor .25
// with floor_snr (3, 8). (The "true flat" map is not part of the merge.) Starts from kernel_estimate.comp.

layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 0, rgba32f) readonly uniform image2D integratedI;
layout(set = 0, binding = 1, rgba32f) readonly uniform image2D localI;
layout(set = 0, binding = 2, rgba32f) writeonly uniform image2D covI;

const float K_DETAIL = 0.20, K_DENOISE = 2.0, D_THRESHOLD = 0.71, D_TRANSITION = 1.0, K_STRETCH = 4.0, K_SHRINK = 2.0;
const float DETAIL_FLOOR = 0.25, FLOOR_SNR_LO = 3.0, FLOOR_SNR_HI = 8.0;

void main() {
    ivec2 q = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(q, imageSize(covI)))) return;
    vec3 loc = imageLoad(localI, q).xyz;
    float ad0 = loc.x - loc.z;
    float l1d = 0.5 * ((loc.x + loc.z) + sqrt(max(0.0, ad0 * ad0 + 4.0 * loc.y * loc.y)));   // local largest eigenvalue
    vec3 t = imageLoad(integratedI, q).xyz;
    float sa = t.x, sb = t.y, sd = t.z;
    float tr = sa + sd, ad = sa - sd;
    float disc = sqrt(max(0.0, ad * ad + 4.0 * sb * sb));
    float l1 = 0.5 * (tr + disc), l2 = 0.5 * (tr - disc);
    vec2 c0 = vec2(sb, l1 - sa), c1 = vec2(l1 - sd, sb);
    bool pick0 = dot(c0, c0) > dot(c1, c1);
    float ex = pick0 ? c0.x : c1.x, ey = pick0 ? c0.y : c1.y;
    bool iso = (sb == 0.0) && (sa == sd);
    float nn = length(vec2(ex, ey));
    nn = nn > 0.0 ? nn : 1.0;
    float e1x = ex / nn, e1y = ey / nn;
    e1x = (ex == 0.0) ? 0.0 : ((ey == 0.0) ? 1.0 : e1x);
    e1y = (ex == 0.0) ? 1.0 : ((ey == 0.0) ? 0.0 : e1y);
    float sg = e1x < 0.0 ? -1.0 : 1.0;
    float e2x = -e1y * sg, e2y = abs(e1x);
    e2x = (ex == 0.0) ? 1.0 : ((ey == 0.0) ? 0.0 : e2x);
    e2y = (ex == 0.0) ? 0.0 : ((ey == 0.0) ? 1.0 : e2y);
    if (iso) { e1x = 1.0; e1y = 0.0; e2x = 0.0; e2y = 1.0; }
    float es = l1 + l2;
    float A = es > 1e-30 ? 1.0 + sqrt(max(0.0, (l1 - l2) / es)) : 1.0;
    float sl = sqrt(max(l1d, 0.0));
    float Dm = clamp(1.0 - sl / D_TRANSITION + D_THRESHOLD, 0.0, 1.0);
    float kk1 = 1.0 + (A - 1.0) * (1.0 / K_SHRINK - 1.0), kk2 = 1.0 + (A - 1.0) * (K_STRETCH - 1.0);
    float k1 = K_DETAIL * ((1.0 - Dm) * kk1 + Dm * K_DENOISE);
    float k2 = K_DETAIL * ((1.0 - Dm) * kk2 + Dm * K_DENOISE);
    float fl = DETAIL_FLOOR * clamp((FLOOR_SNR_HI - sl) / (FLOOR_SNR_HI - FLOOR_SNR_LO), 0.0, 1.0);
    k1 = max(k1, fl);
    k2 = max(k2, fl);
    float s1 = k1 * k1, s2 = k2 * k2;
    imageStore(covI, q, vec4(s1 * e1x * e1x + s2 * e2x * e2x, s1 * e1x * e1y + s2 * e2x * e2y,
                             s1 * e1y * e1y + s2 * e2y * e2y, 0.0));
}
