#version 450
// Port of hdr-plus-swift compute_tile_differences25: cost of each of the 5x5
// integer displacements around the (upscaled) previous alignment. One
// workgroup per tile stages the reference tile and the (T+4)^2 comparison
// window in shared memory (upstream slides a 5-row cache for the same
// reason); 50 lanes each sum one displacement over half the rows (in
// upstream's pairwise order) and the two halves are added. L2 on coarse levels, L1 on the
// finest. Shared arrays fit tiles up to 32 px within Vulkan's 16 KB minimum.
layout(local_size_x = 64) in;
layout(set = 0, binding = 0, r32f) readonly uniform image2D refLevel;
layout(set = 0, binding = 1, r32f) readonly uniform image2D compLevel;
layout(std430, set = 0, binding = 2) readonly buffer Prev { ivec2 v[]; } prev;
layout(std430, set = 0, binding = 3) writeonly buffer Diff { float v[]; } diffs;
layout(push_constant) uniform P {
    ivec2 levelSize;
    ivec2 tiles;
    int downscale;
    int tileSize;
    int useSsd;
} p;

const float FLOAT16_MIN_VAL = -65504.0;
const int MAX_TILE = 32;
const int MAX_WINDOW = MAX_TILE + 4;
shared float sRef[MAX_TILE * MAX_TILE];
shared float sComp[MAX_WINDOW * MAX_WINDOW];
shared float sHalf[50];

void main() {
    ivec2 g = ivec2(gl_WorkGroupID.xy);
    if (g.x >= p.tiles.x || g.y >= p.tiles.y) return;
    int lane = int(gl_LocalInvocationID.x);
    int t = p.tileSize;
    int win = t + 4;
    ivec2 t0 = g * (t / 2);
    ivec2 c0 = t0 + p.downscale * prev.v[g.y * p.tiles.x + g.x] - 2;
    for (int i = lane; i < t * t; i += 64) sRef[i] = imageLoad(refLevel, t0 + ivec2(i % t, i / t)).x;
    for (int i = lane; i < win * win; i += 64) {
        ivec2 s = c0 + ivec2(i % win, i / win);
        // Out-of-frame samples carry a finite high loss (upstream caches
        // FLOAT16_MIN_VAL and compares against twice that in float).
        bool outside = any(lessThan(s, ivec2(0))) || any(greaterThanEqual(s, p.levelSize));
        sComp[i] = outside ? 2.0 * FLOAT16_MIN_VAL : imageLoad(compLevel, s).x;
    }
    barrier();
    if (lane < 50) {
        int disp = lane % 25, part = lane / 25;
        int ox = disp % 5, oy = disp / 5;
        float diff = 0.0;
        for (int dy = part * (t / 2); dy < (part + 1) * (t / 2); ++dy) {
            int rr = dy * t, cr = (dy + oy) * win + ox;
            for (int dx = 0; dx < t; dx += 2) {
                float d0 = abs(sRef[rr + dx] - sComp[cr + dx]);
                float d1 = abs(sRef[rr + dx + 1] - sComp[cr + dx + 1]);
                diff += p.useSsd != 0 ? (d0 * d0 + d1 * d1) : (d0 + d1);
            }
        }
        sHalf[lane] = diff;
    }
    barrier();
    if (lane < 25) diffs.v[(g.y * p.tiles.x + g.x) * 25 + lane] = sHalf[lane] + sHalf[lane + 25];
}
