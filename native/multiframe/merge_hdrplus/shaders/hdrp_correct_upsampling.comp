#version 450
// Port of hdr-plus-swift correct_upsampling_error:
// after nearest upsampling, each tile also tries the alignment of its
// horizontal and vertical coarse neighbours and keeps the best of the three
// (HDR+ paper, improves alignment at moving-object borders). One workgroup
// per tile: each lane reads its tile pixels and the three candidate samples
// once, then a tree reduction sums the three costs (one pass over the tile
// instead of three staged rounds and a serial sum by one lane).
// Bracketed companions first rescale each candidate patch by the ratio of the
// tile means, clamped to +-10% (upstream's non-uniform-exposure path).
// 128 lanes: a 32 px tile is 8 pixels per lane, an 8 px tile still half the lanes busy (256 left most idle there).
#define LANES 128
layout(local_size_x = LANES) in;
layout(set = 0, binding = 0, r32f) readonly uniform image2D refLevel;
layout(set = 0, binding = 1, r32f) readonly uniform image2D compLevel;
layout(std430, set = 0, binding = 2) readonly buffer Prev { ivec2 v[]; } prev;
layout(std430, set = 0, binding = 3) writeonly buffer Corrected { ivec2 v[]; } corrected;
layout(push_constant) uniform P {
    ivec2 levelSize;
    ivec2 tiles;
    int downscale;  // 0 at the coarsest level
    int tileSize;
    int useSsd;
    int exposureRatio;  // 1: bracketed companion
} p;

const int MAX_TILE = 32;
shared vec3 sCost[LANES];
shared vec3 sSum[LANES];   // bracketed: the three candidates' sums

void main() {
    ivec2 g = ivec2(gl_WorkGroupID.xy);
    if (g.x >= p.tiles.x || g.y >= p.tiles.y) return;
    int lane = int(gl_LocalInvocationID.x);
    int t = p.tileSize;
    ivec2 t0 = g * (t / 2);
    ivec3 xs = clamp(ivec3(g.x, g.x + ((g.x % 2 == 0) ? -1 : 1), g.x), 0, p.tiles.x - 1);
    ivec3 ys = clamp(ivec3(g.y, g.y, g.y + ((g.y % 2 == 0) ? -1 : 1)), 0, p.tiles.y - 1);
    ivec2 cand[3];
    for (int c = 0; c < 3; ++c) cand[c] = prev.v[ys[c] * p.tiles.x + xs[c]];
    // Candidate samples of tile pixel i; an out-of-frame sample makes that candidate's cost +inf (upstream computes
    // int * 2 * half(-65504) in half precision, which overflows).
    vec3 ratio = vec3(1.0);
    if (p.exposureRatio != 0) {
        // Bracketed: each candidate's tile-mean ratio over its in-frame samples first.
        vec3 sums = vec3(0.0), refSums = vec3(0.0);
        for (int i = lane; i < t * t; i += LANES) {
            ivec2 q = t0 + ivec2(i % t, i / t);
            float r = max(0.0, imageLoad(refLevel, q).x);
            for (int c = 0; c < 3; ++c) {
                ivec2 s = q + p.downscale * cand[c];
                if (all(greaterThanEqual(s, ivec2(0))) && all(lessThan(s, p.levelSize))) {
                    sums[c] += max(0.0, imageLoad(compLevel, s).x);
                    refSums[c] += r;
                }
            }
        }
        sSum[lane] = sums;
        sCost[lane] = refSums;
        barrier();
        for (int stride = LANES / 2; stride > 0; stride >>= 1) {
            if (lane < stride) {
                sSum[lane] += sSum[lane + stride];
                sCost[lane] += sCost[lane + stride];
            }
            barrier();
        }
        ratio = clamp(sCost[0] / (sSum[0] + 1e-9), 0.9, 1.1);
        barrier();
    }
    vec3 cost = vec3(0.0);
    for (int i = lane; i < t * t; i += LANES) {
        ivec2 q = t0 + ivec2(i % t, i / t);
        float r = imageLoad(refLevel, q).x;
        for (int c = 0; c < 3; ++c) {
            ivec2 s = q + p.downscale * cand[c];
            bool outside = any(lessThan(s, ivec2(0))) || any(greaterThanEqual(s, p.levelSize));
            float d = outside ? uintBitsToFloat(0x7f800000u) : abs(r - ratio[c] * imageLoad(compLevel, s).x);
            cost[c] += p.useSsd != 0 ? d * d : d;
        }
    }
    sCost[lane] = cost;
    barrier();
    for (int stride = LANES / 2; stride > 0; stride >>= 1) {
        if (lane < stride) sCost[lane] += sCost[lane + stride];
        barrier();
    }
    if (lane != 0) return;
    vec3 sDiff = sCost[0];
    ivec2 best = (sDiff[0] < sDiff[1] && sDiff[0] < sDiff[2]) ? cand[0] : (sDiff[1] < sDiff[2] ? cand[1] : cand[2]);
    corrected.v[g.y * p.tiles.x + g.x] = best;
}
