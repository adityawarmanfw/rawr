#version 450
// Port of hdr-plus-swift calculate_rms_rgba: per-tile signal level of the reference, RMS / 4 (HDR+ "noise model and tiled
// approximation"). hdrq_merge evaluates the burst noise model at 4 x this level.
layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 0, rgba16f) readonly uniform image2D refRgba;
layout(set = 0, binding = 1, rgba32f) writeonly uniform image2D rms;
layout(push_constant) uniform P {
    ivec2 tiles;
    float frameInv;  // 1 / fp16 storage scale of the frames
} p;

void main() {
    ivec2 g = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(g, p.tiles))) return;
    ivec2 t0 = g * 8;
    vec4 acc = vec4(0.0);
    for (int dy = 0; dy < 8; ++dy)
        for (int dx = 0; dx < 8; ++dx) {
            vec4 v = imageLoad(refRgba, t0 + ivec2(dx, dy)) * p.frameInv;
            acc += v * v;
        }
    imageStore(rms, g, 0.25 * sqrt(acc) / 8.0);
}
