#version 450
// Raw-domain accumulator -> normalized merge output. Every channel carries the
// site's own value so CFA consumers (project_cfa_u16, prepare_packed_cfa) that
// read rgb[channelForSite] work for any CFA order.
layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 0, r32f) readonly uniform image2D accum;
layout(set = 0, binding = 1, rgba16f) writeonly uniform image2D outputImage;
layout(push_constant) uniform P {
    vec4 black;  // reference black per (y&1)*2+(x&1) phase
    float white;
    ivec2 size;
} p;

void main() {
    ivec2 q = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(q, p.size))) return;
    float b = p.black[(q.y & 1) * 2 + (q.x & 1)];
    float v = (imageLoad(accum, q).x - b) / max(1.0, p.white - b);
    imageStore(outputImage, q, vec4(v, v, v, 1.0));
}
