#version 450
#extension GL_GOOGLE_include_directive : require
#ifndef RAWR_BENCH_BYPASS_HIGHLIGHT
#define RAWR_BENCH_BYPASS_HIGHLIGHT 0
#endif
#ifndef RAWR_BENCH_BYPASS_CHROMA
#define RAWR_BENCH_BYPASS_CHROMA 0
#endif
#ifndef RAWR_BENCH_MINIMAL_DIRECT
#define RAWR_BENCH_MINIMAL_DIRECT 0
#endif
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(set = 0, binding = 0, r16ui) uniform readonly uimage2D rawImage;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D outImage;
layout(set = 0, binding = 2, r16ui) uniform writeonly uimage2D cfaStateImage;
// Byte-addressed view of the same camera AHB (see raw_preview.comp).
layout(std430, set = 0, binding = 4) readonly buffer ImportedRawBuffer { uint words[]; } importedRaw;
// Nonzero once any output cell has a sensor-clipped sample: the host skips the
// colour-propagation chain (conditional rendering) when it stays zero.
layout(std430, set = 0, binding = 5) buffer ClipFlag { uint anyClipped; } clipFlag;
layout(push_constant) uniform PC {
    vec4 black;
    vec4 invRange;
    vec4 wb;
    float clipThreshold;
    float edgeStrength;
    float chromaBlend;
    float highlightWarningThreshold;
    float shadowWarningThreshold;
    float pad0;
    uint width;
    uint height;
    uint pattern;
    uint lscEnabled;
    uint lscWidth;
    uint lscHeight;
    uint highlightReconstructionEnabled;
    uint rawStridePixels;
    uint rawBufferEnabled;
}
pc;
#define LSC_BINDING 3
#include "lens_shading.glsl"
#include "cfa_common.glsl"

struct BayerCell {
    vec3 rgb;
    uint validMask;
};
shared vec4 sCell[100];  // rgb + mask encoded in a
bool isChannelValid(BayerCell c, int ch) { return (c.validMask & (1u << uint(ch))) != 0u; }

float normalizeSensorValue(float rawValue, int c) { return clamp((rawValue - pc.black[c]) * pc.invRange[c], 0.0, 1.0); }

uint rawSampleAt(ivec2 q) {
    if (pc.rawBufferEnabled != 0u) {
        uint linear = uint(q.y) * pc.rawStridePixels + uint(q.x);
        uint word = importedRaw.words[linear >> 1u];
        return ((linear & 1u) == 0u) ? (word & 0xffffu) : (word >> 16u);
    }
    return imageLoad(rawImage, q).r;
}


uint stateForSample(float rawValue, float normalized, int c) {
    uint state = 0u;
    if (normalized >= pc.clipThreshold) state |= (1u << uint(c));
    if (normalized >= pc.highlightWarningThreshold) state |= (1u << uint(c + 4));
    if (normalized <= pc.shadowWarningThreshold) state |= (1u << uint(c + 8));
    if (rawValue <= pc.black[c]) state |= (1u << uint(c + 12));
    return state;
}

BayerCell loadBayerCell(ivec2 cell) {
    ivec2 outputSize = ivec2(int(pc.width >> 1), int(pc.height >> 1));
    cell = clamp(cell, ivec2(0), outputSize - ivec2(1));
    ivec2 qr, qg1, qg2, qb;
    rawrCfaCellCoordinates(pc.pattern, cell, qr, qg1, qg2, qb);
    float rawR = float(rawSampleAt(qr));
    float rawG1 = float(rawSampleAt(qg1));
    float rawG2 = float(rawSampleAt(qg2));
    float rawB = float(rawSampleAt(qb));
    float rr = normalizeSensorValue(rawR, 0);
    float gg1 = normalizeSensorValue(rawG1, 1);
    float gg2 = normalizeSensorValue(rawG2, 2);
    float bb = normalizeSensorValue(rawB, 3);

    bool vr = rr < pc.clipThreshold;
    bool v1 = gg1 < pc.clipThreshold;
    bool v2 = gg2 < pc.clipThreshold;
    bool vb = bb < pc.clipThreshold;
    uint cfaState = stateForSample(rawR, rr, 0) | stateForSample(rawG1, gg1, 1) | stateForSample(rawG2, gg2, 2) |
                    stateForSample(rawB, bb, 3);

    // One lookup per cell at its centre; greens pick the map channel from
    // their sensor-row parity, as lensShadingGain does.
    vec4 shading = lensShadingGainsAt(vec2(min(min(qr, qg1), min(qg2, qb))) + vec2(0.5));
    rr *= shading.x;
    gg1 *= shading[1 + (qg1.y & 1)];
    gg2 *= shading[1 + (qg2.y & 1)];
    bb *= shading.w;
    // Form RGB first. Selecting only the unclipped green sample here would be
    // a second, pre-RGB recovery stage and would expose the G1/G2 clip contour.
    float g = 0.5 * (gg1 + gg2);
    uint validMask = (vr ? 1u : 0u) | ((v1 || v2) ? 2u : 0u) | (vb ? 4u : 0u);
    return BayerCell(vec3(rr, g, bb), validMask | (cfaState << 3));
}

BayerCell loadTileCell(ivec2 d) {
    ivec2 p = ivec2(gl_LocalInvocationID.xy) + ivec2(1) + d;
    vec4 q = sCell[p.y * 10 + p.x];
    uint packed = uint(q.a + 0.5);
    return BayerCell(q.rgb, packed);
}

float edgeWeight(float a, float b) { return 1.0 / (1.0 + pc.edgeStrength * abs(a - b)); }



#include "raw_highlight_post_rgb.glsl"


void main() {
    ivec2 o = ivec2(gl_GlobalInvocationID.xy);
    ivec2 os = ivec2(int(pc.width >> 1), int(pc.height >> 1));
#if RAWR_BENCH_MINIMAL_DIRECT
    if (any(greaterThanEqual(o, os))) return;
    BayerCell packedDirect = loadBayerCell(o);
    uint directCfaState = packedDirect.validMask >> 3;
    packedDirect.validMask &= 7u;
    float directGwb = 0.5 * (pc.wb.y + pc.wb.z);
    imageStore(outImage, o, vec4(max(packedDirect.rgb, vec3(0.0)) * vec3(pc.wb.x, directGwb, pc.wb.w), 1.0));
    imageStore(cfaStateImage, o, uvec4(directCfaState, 0u, 0u, 0u));
    if ((directCfaState & 15u) != 0u) clipFlag.anyClipped = 1u;
    return;
#else
    uint lid = gl_LocalInvocationIndex;
    ivec2 groupOrigin = ivec2(gl_WorkGroupID.xy) * 8 - ivec2(1);
    for (uint i = lid; i < 100u; i += 64u) {
        ivec2 t = ivec2(int(i % 10u), int(i / 10u));
        BayerCell c = loadBayerCell(groupOrigin + t);
        sCell[i] = vec4(c.rgb, float(c.validMask));
    }
    barrier();
    if (any(greaterThanEqual(o, os))) return;

    uint centerIndex = (gl_LocalInvocationID.y + 1u) * 10u + (gl_LocalInvocationID.x + 1u);
    uint centerPacked = uint(sCell[centerIndex].a + 0.5);
    uint centerCfaState = centerPacked >> 3;
    BayerCell rawCenter = loadTileCell(ivec2(0));
    uint originalMask = rawCenter.validMask & 7u;
    rawCenter.validMask = originalMask;
    BayerCell c = rawCenter;

    float rg0 = c.rgb.r - c.rgb.g, bg0 = c.rgb.b - c.rgb.g;
    float rg = rg0, bg = bg0;
#if !RAWR_BENCH_BYPASS_CHROMA
    if (originalMask == 7u && pc.chromaBlend > 0.0) {
        float rgSum = 0.0, rgW = 0.0, bgSum = 0.0, bgW = 0.0;
        const ivec2 dirs[4] = ivec2[4](ivec2(0, -1), ivec2(-1, 0), ivec2(1, 0), ivec2(0, 1));
        for (int i = 0; i < 4; i++) {
            BayerCell n = loadTileCell(dirs[i]);
            float w = edgeWeight(c.rgb.g, n.rgb.g);
            if (isChannelValid(n, 0) && isChannelValid(n, 1)) {
                rgSum += w * (n.rgb.r - n.rgb.g);
                rgW += w;
            }
            if (isChannelValid(n, 2) && isChannelValid(n, 1)) {
                bgSum += w * (n.rgb.b - n.rgb.g);
                bgW += w;
            }
        }
        if (rgW > 1e-6) rg = mix(rg0, rgSum / rgW, pc.chromaBlend);
        if (bgW > 1e-6) bg = mix(bg0, bgSum / bgW, pc.chromaBlend);
    }
#endif
    vec3 sensor = max(vec3(c.rgb.g + rg, c.rgb.g, c.rgb.g + bg), vec3(0.0));
    float gwb = 0.5 * (pc.wb.y + pc.wb.z);
    vec3 rgb = sensor * vec3(pc.wb.x, gwb, pc.wb.w);
#if !RAWR_BENCH_BYPASS_HIGHLIGHT
    uint highlightMode = pc.highlightReconstructionEnabled;
    vec3 ceilings = vec3(pc.wb.x, gwb, pc.wb.w);
    if (highlightMode == 0u) {
        rgb = reconstructPostWbHighlight(rgb, ceilings, vec3(0.0), false, false);
    }
    // Mode 2: ordinary post-WB RGB; reconstruction runs in the raw_highlight
    // passes (colour-propagation guide chain or Inpaint Opposed) afterwards.
#endif
    imageStore(outImage, o, vec4(rgb, 1.0));
    imageStore(cfaStateImage, o, uvec4(centerCfaState, 0u, 0u, 0u));
    if ((centerCfaState & 15u) != 0u) clipFlag.anyClipped = 1u;
#endif
}
