#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(binding = 0, rgba16f) uniform readonly image2D srcRgb;
layout(binding = 1, rgba16f) uniform writeonly image2D dstRgb;
// Single-word highlight predicate (bit 0 set when any pixel may need guide
// reconstruction). Written with atomics; the guide chain dispatches are
// predicated on it via VK_EXT_conditional_rendering when available.
layout(std430, binding = 2) buffer Predicate { uint words[]; } predicate;

shared uint sNeed;
layout(push_constant) uniform Push {
    uint width;
    uint height;
    float rGain;
    float gGain;
    float bGain;
    // Optional geometric undistort. 0 = passthrough (bit-exact imageLoad),
    // 1 = Camera2 LENS_DISTORTION inverse-model resample, 2 = OpenCV rational
    // forward-model resample (lens profile calibration, k4..k6 / fxOut below).
    uint enableDistortion;
    float fx;
    float fy;
    float cx;
    float cy;
    // [k1, k2, p1, p2, k3]: x_d = x*(1+k1*r^2+k2*r^4+k3*r^6) + 2*p1*x*y + p2*(r^2+2*x^2)
    //                       y_d = y*(1+k1*r^2+k2*r^4+k3*r^6) + p1*(r^2+2*y^2) + 2*p2*x*y
    // with x,y in focal units relative to (cx,cy).
    float k1;
    float k2;
    float p1;
    float p2;
    float k3;
    // Pixel-local highlight stage fused into this pass, replacing the
    // separate highlight_recover.comp dispatch for these modes:
    // 0 = none (colour propagation runs its own pass), 1 = HL off common-ceiling
    // clamp (recover enabled 0), 2 = Inpaint Opposed passthrough (enabled 2).
    uint highlightMode;
    // Rational model only: denominator k4..k6 and the output focal (fx, fy
    // scaled to fill the frame); fx/fy above denormalize into the source.
    float k4;
    float k5;
    float k6;
    float fxOut;
    float fyOut;
    // Rational only: this image is a crop of the calibrated frame (video);
    // image pixel p = frame pixel origin + (p + 0.5) * frameScale - 0.5.
    float originX;
    float originY;
    float frameScale;
}
pc;

#include "raw_highlight_post_rgb.glsl"

// The separate stage read the WB result back from an RGBA16F image. Both
// highlight modes are monotone clamps, so applying them before the single
// store rounds the same way; only half-float overflow must be reproduced,
// because the stored infinity is sanitized to zero.
vec3 asStoredHalf(vec3 v) {
    const float inf = uintBitsToFloat(0x7f800000u);
    return mix(v, sign(v) * inf, greaterThanEqual(abs(v), vec3(65520.0)));
}

vec4 sampleBilinear(ivec2 extent, vec2 uv) {
    vec2 clamped = clamp(uv, vec2(0.0), vec2(extent) - vec2(1.0));
    ivec2 p0 = ivec2(floor(clamped));
    ivec2 p1 = min(p0 + ivec2(1), extent - ivec2(1));
    vec2 f = clamped - vec2(p0);
    vec4 a = imageLoad(srcRgb, ivec2(p0.x, p0.y));
    vec4 b = imageLoad(srcRgb, ivec2(p1.x, p0.y));
    vec4 c = imageLoad(srcRgb, ivec2(p0.x, p1.y));
    vec4 d = imageLoad(srcRgb, ivec2(p1.x, p1.y));
    return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}

// Camera2 LENS_DISTORTION maps a corrected output coordinate directly to
// its source sample. Do not invert it: that reverses the correction.
vec2 camera2Source(vec2 outPixel) {
    vec2 x = (outPixel - vec2(pc.cx, pc.cy)) / vec2(pc.fx, pc.fy);
    float r2 = dot(x, x);
    float radial = 1.0 + r2 * (pc.k1 + r2 * (pc.k2 + r2 * pc.k3));
    vec2 source = vec2(x.x * radial + 2.0 * pc.p1 * x.x * x.y + pc.p2 * (r2 + 2.0 * x.x * x.x),
                       x.y * radial + pc.p1 * (r2 + 2.0 * x.y * x.y) + 2.0 * pc.p2 * x.x * x.y);
    return vec2(pc.cx, pc.cy) + source * vec2(pc.fx, pc.fy);
}

// OpenCV rational model: corrected output pixel -> distorted source pixel.
vec2 rationalSource(vec2 outPixel) {
    vec2 origin = vec2(pc.originX, pc.originY);
    vec2 outUv = origin + (outPixel + 0.5) * pc.frameScale - 0.5;
    vec2 x = (outUv - vec2(pc.cx, pc.cy)) / vec2(pc.fxOut, pc.fyOut);
    float r2 = dot(x, x);
    float radial = (1.0 + r2 * (pc.k1 + r2 * (pc.k2 + r2 * pc.k3))) / (1.0 + r2 * (pc.k4 + r2 * (pc.k5 + r2 * pc.k6)));
    vec2 d = vec2(x.x * radial + 2.0 * pc.p1 * x.x * x.y + pc.p2 * (r2 + 2.0 * x.x * x.x),
                  x.y * radial + pc.p1 * (r2 + 2.0 * x.y * x.y) + 2.0 * pc.p2 * x.x * x.y);
    vec2 source = vec2(pc.cx, pc.cy) + d * vec2(pc.fx, pc.fy);
    return (source - origin + 0.5) / pc.frameScale - 0.5;
}

void main() {
    // Shared predicate reduction; every thread in the workgroup must reach
    // both barriers, including threads outside the image extent.
    if (gl_LocalInvocationIndex == 0u) sNeed = 0u;
    barrier();
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (uint(p.x) < pc.width && uint(p.y) < pc.height) {
        vec4 s;
        if (pc.enableDistortion == 0u) {
            s = imageLoad(srcRgb, p);
        } else {
            vec2 source = pc.enableDistortion == 2u ? rationalSource(vec2(p)) : camera2Source(vec2(p));
            s = sampleBilinear(ivec2(pc.width, pc.height), source);
        }
        vec3 wb = s.rgb * vec3(pc.rGain, pc.gGain, pc.bGain);
        vec3 outRgb = wb;
        if (pc.highlightMode == 1u)
            outRgb = reconstructPostWbHighlight(asStoredHalf(wb), vec3(pc.rGain, pc.gGain, pc.bGain), vec3(0.0), false,
                                                false);
        else if (pc.highlightMode == 2u)
            outRgb = rawrHighlightSanitize(asStoredHalf(wb));
        imageStore(dstRgb, p, vec4(outRgb, s.a));

        // Conservative highlight-guide predicate, fused here to avoid an extra
        // full-resolution pass. The recovery stage reconstructs a pixel only when
        // smoothstep(0.85, 1.0, channel / ceiling) exceeds 1e-6 for some channel,
        // i.e. only when a stored post-WB channel exceeds ~0.85x its ceiling.
        // Flagging every pixel above 0.849x (with ceilings mirrored exactly as
        // the recovery stage derives them) can only over-report: a skipped guide
        // chain implies no pixel exceeded 0.85x even allowing fp16 store rounding
        // (sub-ULP at these magnitudes), so the recovery early-return is taken
        // everywhere and the guide image is never read. NaN compares false and
        // is sanitized to 0 downstream (also guide-free); +Inf compares true.
        vec3 ceilings = max(min(max(vec3(pc.rGain, pc.gGain, pc.bGain), vec3(0.0)), vec3(60000.0)), vec3(1e-4));
        if (any(greaterThan(wb, vec3(0.849) * ceilings))) atomicOr(sNeed, 1u);
    }
    barrier();
    if (gl_LocalInvocationIndex == 0u && sNeed != 0u) atomicOr(predicate.words[0], 1u);
}
