#version 450
// SPDX-License-Identifier: GPL-3.0-or-later
// Writes one tile's AMaZE result into the caller's RGBA16F image, removing the
// white balance applied for AMaZE so the output is camera-linear like RCD's.
//
// The outer kBorder pixels of the image get librtprocess's bayerborder_demosaic instead: AMaZE's candidates
// only exist inside [4, size - 4) of a tile, and an edge tile here starts at the image edge (librtprocess
// mirrors 16 px beyond it), so its outermost pixels come out as the bare CFA sample (a 2-px checker) and the
// next few are weakened. Same 3x3 same-colour mean as the RCD path (rcd_common.glsl).
layout(local_size_x = 16, local_size_y = 16) in;
#include "amaze_tile.glsl"
layout(std430, set = 0, binding = 0) readonly buffer Source { uint words[]; } source;
layout(std430, set = 0, binding = 2) readonly buffer TileOutput { vec4 rgb[]; } result;
layout(set = 0, binding = 6, rgba16f) uniform writeonly image2D outputImage;

const int kBorder = 8;

// CFA sample (0..1, no white balance) at image position g, from this tile's source slot.
float sourceAt(ivec2 g) {
    uvec2 l = uvec2(g - ivec2(tile.srcOriginX, tile.srcOriginY));
    return max(0.0, uintBitsToFloat(source.words[TILE_SLOT * kSrcPix + l.y * tile.srcWidth + l.x]));
}
// 0 = R, 1 = G, 2 = B at image position g (amaze.wgsl cfa_global).
uint colourAt(ivec2 g) {
    bool odd = (g.x & 1) == 1;
    return (g.y & 1) == 0 ? (odd ? tile.cfa10 : tile.cfa00) : (odd ? tile.cfa11 : tile.cfa01);
}
vec3 borderRgb(ivec2 g, ivec2 size) {
    ivec2 lo = ivec2(tile.srcOriginX, tile.srcOriginY);
    ivec2 hi = lo + ivec2(tile.srcWidth, tile.srcHeight) - 1;
    vec3 sum = vec3(0.0);
    vec3 count = vec3(0.0);
    for (int dy = -1; dy <= 1; ++dy) {
        for (int dx = -1; dx <= 1; ++dx) {
            ivec2 q = g + ivec2(dx, dy);
            if (any(lessThan(q, max(lo, ivec2(0)))) || any(greaterThan(q, min(hi, size - 1)))) continue;
            uint c = colourAt(q);
            sum[c] += sourceAt(q);
            count[c] += 1.0;
        }
    }
    vec3 rgb = sum / max(count, vec3(1.0));
    rgb[colourAt(g)] = sourceAt(g);
    return rgb;
}

void main() {
    uvec2 l = gl_GlobalInvocationID.xy;
    if (l.x >= tile.outWidth || l.y >= tile.outHeight) return;
    ivec2 g = ivec2(tile.outOriginX + l.x, tile.outOriginY + l.y);
    ivec2 size = ivec2(int(tile.inputWidth), int(tile.reserved));
    vec3 rgb;
    if (g.x < kBorder || g.y < kBorder || g.x >= size.x - kBorder || g.y >= size.y - kBorder) {
        rgb = borderRgb(g, size);
    } else {
        rgb = result.rgb[TILE_SLOT * kOutPix + l.y * tile.outWidth + l.x].rgb / vec3(tile.wbR, tile.wbG, tile.wbB);
    }
    imageStore(outputImage, g, vec4(rgb * tile.outputScale, tile.outputAlpha));
}
