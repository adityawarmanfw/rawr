#version 450
// Sums the 16 measure partitions into SceneExposureStatsData.
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
layout(std430, binding = 0) readonly buffer Partial { uint data[]; }
partial;
layout(std430, binding = 1) buffer Out {
    uint weightedBins[256];
    uint totalWeight;
    uint sampleCount;
    uint clippedWeight;
    uint reserved;
    uint channelBins[256];
    uint frameLogSum;
    uint frameSamples;
    uint focusSamples;
    uint reserved2;
    uint focusBins[256];
}
outb;
const uint PARTITIONS = 16u;
const uint BIN_COUNT = 256u;
const uint COUNTERS = 8u;
const uint STRIDE = 3u * BIN_COUNT + COUNTERS;

void main() {
    uint i = gl_LocalInvocationIndex;
    uint sum = 0u, channel = 0u, focus = 0u;
    for (uint p = 0u; p < PARTITIONS; ++p) {
        sum += partial.data[p * STRIDE + i];
        channel += partial.data[p * STRIDE + BIN_COUNT + i];
        focus += partial.data[p * STRIDE + 2u * BIN_COUNT + i];
    }
    outb.weightedBins[i] = sum;
    outb.channelBins[i] = channel;
    outb.focusBins[i] = focus;
    if (i < COUNTERS) {
        uint c = 0u;
        for (uint p = 0u; p < PARTITIONS; ++p) c += partial.data[p * STRIDE + 3u * BIN_COUNT + i];
        if (i == 0u) outb.totalWeight = c;
        if (i == 1u) outb.sampleCount = c;
        if (i == 2u) outb.clippedWeight = c;
        if (i == 3u) outb.reserved = 0u;
        if (i == 4u) outb.frameLogSum = c;
        if (i == 5u) outb.frameSamples = c;
        if (i == 6u) outb.focusSamples = c;
        if (i == 7u) outb.reserved2 = 0u;
    }
}
