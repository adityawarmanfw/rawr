// exposureSaturation.x/.w, renderConfig.x and reserved0-2 are unused; the
// layout is kept to match TonemapEngine's GpuParameters.
layout(std140, binding = 2) uniform TonemapGpuParams {
    mat4 cameraToWorking;         // upper-left mat3; mat4 avoids mat3 packing ambiguity
    vec4 gradePivot;              // grade-space 18% gray: NTRL (DI), user LUT, direct; w: user LUT black code
    vec4 exposureSaturation;      // unused, exposureEV, saturation, unused
    vec4 colorControls;           // vibrance, strength, shadow guard start/end (linear luma)
    vec4 renderConfig;            // unused, aePostGainEV, ShadowsUI, MidtonesUI
    vec4 toneControls;            // ContrastUI, HighlightsUI, BlacksUI, WhitesUI
    vec4 gradeLuma;               // user LUT input gamut luma weights
    vec4 reserved0;
    vec4 reserved1;
    vec4 reserved2;
    uvec4 extent;                // output width/height, input width/height
    uvec4 lutControl;            // enabled,stageCount,inputGamut,inputTransfer
    uvec4 lutOutput;             // outputGamut,outputTransfer,placement,afterAction(0=direct,1=convert sRGB)
    vec4 lutBlend;               // intensity,combineUserGamut,combineNeutralGamut,unused
    uvec4 lutStageIndexSize[8];  // texelOffset,size,unused,unused
    vec4 lutDomainMin[8];
    vec4 lutDomainMax[8];
    mat4 neutralGamut;
    mat4 userInputGamut;
    mat4 userOutputGamut;
    uvec4 directRender; // transform, output gamut, output transfer, reserved
    vec4 adaptiveTone; // lift EV, key EV, protected highlight EV
    mat4 agxAp1ToBase;       // AgX (directRender.x == 4) only, see agx.glsl
    mat4 agxBaseToRendering;
    mat4 agxRenderingToSrgb;
    vec4 agxLog;             // black EV, range EV, gamma, preserve hue
    vec4 agxLine;            // slope, intercept, target black, target white
    vec4 agxToe;             // power, transition x, transition y, scale
    vec4 agxShoulder;        // power, transition x, transition y, scale
    vec4 agxFallback;        // toe coefficient, toe power, shoulder coefficient, shoulder power
    vec4 agxLook;            // lift, slope, power, saturation
    vec4 agxLookLuma;
    uvec4 agxFlags;          // convex toe, concave shoulder, look tuned, restore hue
}
P;

