// highlightCompression > 0 applies the Inpaint Opposed SDR tone tap
// (coloropp_tone.comp) to the input here instead of in its own pass.
layout(push_constant) uniform VideoMonitorParams {
    uint monitorEnabled;
    float highlightCompression;
    float highlightExposureGain;
} videoMonitor;

float highlightFactor(float level) {
    if (videoMonitor.highlightCompression <= 0.0 || level <= 0.0) return 1.0;
    float shoulder = 0.1 / 65536.0;
    float scaled = max(level - shoulder, 0.0) * videoMonitor.highlightCompression / (1.0 - shoulder);
    return scaled > 1e-7 ? log(1.0 + scaled) / scaled : 1.0;
}
// The separate tap stored its result as RGBA16F; round the same way
// (nearest, ties to even) in integer math.
float roundHalf(float f) {
    uint x = floatBitsToUint(f), sign = x & 0x80000000u, a = x & 0x7fffffffu;
    if (a >= 0x7f800000u) return f;
    if (a >= 0x477ff000u) return uintBitsToFloat(sign | 0x7f800000u);
    if (a < 0x38800000u) {
        float q = roundEven(uintBitsToFloat(a) * 16777216.0) / 16777216.0;
        return uintBitsToFloat(sign | floatBitsToUint(q));
    }
    a += 0x0fffu + ((a >> 13) & 1u);
    return uintBitsToFloat(sign | (a & ~0x1fffu));
}
vec3 applyHighlightTone(vec3 value) {
    if (videoMonitor.highlightCompression <= 0.0) return value;
    vec3 exposed = value * videoMonitor.highlightExposureGain;
    float scale = (highlightFactor(exposed.r) + highlightFactor(exposed.g) + highlightFactor(exposed.b)) / 3.0;
    vec3 toned = value * scale;
    return vec3(roundHalf(toned.r), roundHalf(toned.g), roundHalf(toned.b));
}
#endif
#endif
