// knotX01_23, knotX4_exposure_sat_gc.x/.w, curve0-3 and renderConfig.x are
// still filled by the host but no longer read here; the layout is kept to
// match TonemapEngine's GpuParameters.
layout(std140, binding = 2) uniform TonemapGpuParams {
    mat4 cameraToWorking;         // upper-left mat3; mat4 avoids mat3 packing ambiguity
    vec4 knotX01_23;              // x0,x1,x2,x3
    vec4 knotX4_exposure_sat_gc;  // x4, exposureEV, saturation, gamutCompressionStart
    vec4 colorControls;           // vibrance, strength, shadowStart, shadowEnd
    vec4 renderConfig;            // middleGray, aePostGainEV, ShadowsUI, MidtonesUI
    vec4 toneControls;            // ContrastUI, HighlightsUI, BlacksUI, WhitesUI
    vec4 curve0;
    vec4 curve1;
    vec4 curve2;
    vec4 curve3;
    uvec4 extent;                // output width/height, input width/height
    uvec4 lutControl;            // enabled,stageCount,inputGamut,inputTransfer
    uvec4 lutOutput;             // outputGamut,outputTransfer,placement,afterAction(0=direct,1=convert sRGB)
    vec4 lutBlend;               // intensity,combineUserGamut,combineNeutralGamut,unused
    uvec4 lutStageIndexSize[8];  // texelOffset,size,unused,unused
    vec4 lutDomainMin[8];
    vec4 lutDomainMax[8];
    mat4 neutralGamut;
    mat4 userInputGamut;
    mat4 userOutputGamut;
    uvec4 directRender; // transform, output gamut, output transfer, reserved
}
P;

// RAWR NTRL production technical LUT. Baked 65^3 transform with contract:
// DaVinci Wide Gamut / DaVinci Intermediate -> encoded sRGB.
// R is the fastest LUT axis.
#ifndef RAWR_TONEMAP_NEUTRAL_TEXTURE
#define RAWR_TONEMAP_NEUTRAL_TEXTURE 0
#endif
#if RAWR_TONEMAP_NEUTRAL_TEXTURE
layout(binding = 3) uniform sampler3D neutralLutTexture;
#else
layout(std430, binding = 3) readonly buffer RawrNeutralTechnicalLut { vec4 texel[]; }
RN;
#endif

// Optional user LUT chain. The engine always binds a valid SSBO; when LUTs are
// disabled lutControl.x is zero and this buffer contains one harmless texel.
#ifndef RAWR_TONEMAP_USER_TEXTURE
#define RAWR_TONEMAP_USER_TEXTURE 0
#endif
#if RAWR_TONEMAP_USER_TEXTURE
