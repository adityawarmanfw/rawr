#version 450
#extension GL_GOOGLE_include_directive : require
// Low-res log luminance: mean log2 render luma over each block x block cell.
// Writes (I, I^2) for the guided filter.
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0, rgba16f) uniform readonly image2D src;
layout(binding = 1, rg32f) uniform writeonly image2D dst;
#include "ltm_common.glsl"

void main() {
    ivec2 q = ivec2(gl_GlobalInvocationID.xy);
    if (q.x >= int(pc.size.z) || q.y >= int(pc.size.w)) return;
    ivec2 origin = q * int(pc.block);
    ivec2 limit = min(origin + ivec2(int(pc.block)), ivec2(pc.size.xy));
    float sum = 0.0;
    float count = 0.0;
    for (int y = origin.y; y < limit.y; ++y)
        for (int x = origin.x; x < limit.x; ++x) {
            sum += rawrLtmLogLuma(imageLoad(src, ivec2(x, y)).rgb);
            count += 1.0;
        }
    float i = sum / max(count, 1.0);
    imageStore(dst, q, vec4(i, i * i, 0.0, 0.0));
}
