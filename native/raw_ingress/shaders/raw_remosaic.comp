#version 450
// Block CFA (quad 2x2 / 4x4 same-colour blocks) -> Bayer remosaic. The camera
// rows are first copied (RAW16, transfer) or unpacked (RAW10, pass 3) into an
// R16 scratch image: image loads are cached in 2D where storage-buffer loads
// of the camera buffer are not (Adreno 840: 9 ms -> see RawRemosaicker.cpp).
// One shader, passes by pc.pass:
//  3. RAW10 only: unpack the camera rows into the raw image;
// Standard:
//  0. green at every pixel into the green image, and per R/B block the
//     mean of raw - green and the mean green;
//  2. Bayer out into the destination image.
// Fast:
//  4. per block, the mean raw;
//  5. Bayer out from the block means.
// Mirrors app/src/main/cpp/imaging/CfaRemosaic.h expression for expression;
// tests/native/raw_remosaic_vulkan_test.cpp compares the two.
layout(local_size_x = 16, local_size_y = 16) in;
layout(std430, set = 0, binding = 0) readonly buffer Source { uint words[]; } src;
layout(set = 0, binding = 1, r16ui) writeonly uniform uimage2D dst;
// Written through 2/3, read through the readonly aliases 5/6 (same views):
// Adreno caches only readonly image loads.
layout(set = 0, binding = 2, r16ui) writeonly uniform uimage2D rawImage;
layout(set = 0, binding = 3, r16ui) writeonly uniform uimage2D greenImage;
// Per block: Standard (raw - green mean, green mean); Fast (raw mean, unused).
layout(std430, set = 0, binding = 4) writeonly buffer Diff { vec2 values[]; } diff;
layout(set = 0, binding = 5, r16ui) readonly uniform uimage2D rawRead;
layout(set = 0, binding = 6, r16ui) readonly uniform uimage2D greenRead;
layout(std430, set = 0, binding = 7) readonly buffer DiffRead { vec2 values[]; } diffRead;
layout(push_constant) uniform P {
    uint width;
    uint height;
    uint rowStrideBytes;
    uint block;
    uint order;
    uint raw10;
    uint pass;
    uint blocksX;
    uint blocksY;
    uint parityR;  // block parity of R and B: (py << 1) | px
    uint parityB;
}
pc;

uint byteAt(uint offset) { return (src.words[offset >> 2u] >> ((offset & 3u) * 8u)) & 0xffu; }

float rawAt(int x, int y) {
    ivec2 p = ivec2(clamp(x, 0, int(pc.width) - 1), clamp(y, 0, int(pc.height) - 1));
    return float(imageLoad(rawRead, p).r);
}

// 0 R, 1 G, 2 B at block (or pixel) parity.
uint channelAt(uint x, uint y) {
    uint i = (y & 1u) * 2u + (x & 1u);
    if (pc.order == 0u) return i == 0u ? 0u : (i == 3u ? 2u : 1u);
    if (pc.order == 1u) return i == 1u ? 0u : (i == 2u ? 2u : 1u);
    if (pc.order == 2u) return i == 2u ? 0u : (i == 1u ? 2u : 1u);
    return i == 3u ? 0u : (i == 0u ? 2u : 1u);
}

// Green for the 2x2 group at (x0, y0), always inside one block. Same
// arithmetic per pixel as CfaRemosaicGreen::at; the horizontal terms depend
// only on the row and the vertical ones only on the column, so each is
// loaded once per group.
void greenGroup(uint x0, uint y0, out float g[4]) {
    int N = int(pc.block), X0 = int(x0), Y0 = int(y0);
    int bx = X0 / N * N, by = Y0 / N * N;
    bool green = channelAt(x0 / pc.block, y0 / pc.block) == 1u;
    int xl = bx - 1 >= 0 ? bx - 1 : bx + N;
    int xr = bx + N < int(pc.width) ? bx + N : xl;
    int yt = by - 1 >= 0 ? by - 1 : by + N;
    int yb = by + N < int(pc.height) ? by + N : yt;
    float gh[2][2], gv[2][2], ah[2], av[2];
    for (int j = 0; j < 2; ++j) {
        int Y = Y0 + j;
        float gl = rawAt(xl, Y), gr = rawAt(xr, Y);
        ah[j] = abs(gl - gr) + abs(rawAt(bx, Y) - rawAt(bx + N - 1, Y)) +
                0.5 * abs(rawAt(bx - 2 * N + N - 1, Y) - rawAt(bx + 2 * N, Y));
        for (int i = 0; i < 2; ++i) {
            float th = xr != xl ? float(X0 + i - xl) / float(xr - xl) : 0.5;
            gh[j][i] = gl + (gr - gl) * th;
        }
    }
    for (int i = 0; i < 2; ++i) {
        int X = X0 + i;
        float gt = rawAt(X, yt), gb = rawAt(X, yb);
        av[i] = abs(gt - gb) + abs(rawAt(X, by) - rawAt(X, by + N - 1)) +
                0.5 * abs(rawAt(X, by - 2 * N + N - 1) - rawAt(X, by + 2 * N));
        for (int j = 0; j < 2; ++j) {
            float tv = yb != yt ? float(Y0 + j - yt) / float(yb - yt) : 0.5;
            gv[j][i] = gt + (gb - gt) * tv;
        }
    }
    const float kEps = 1.0;
    for (int j = 0; j < 2; ++j)
        for (int i = 0; i < 2; ++i) {
            if (green) {
                g[j * 2 + i] = rawAt(X0 + i, Y0 + j);
                continue;
            }
            float wh = 1.0 / ((ah[j] + kEps) * (ah[j] + kEps)), wv = 1.0 / ((av[i] + kEps) * (av[i] + kEps));
            g[j * 2 + i] = (wh * gh[j][i] + wv * gv[j][i]) / (wh + wv);
        }
}

uint roundDn(float v) { return uint(clamp(floor(abs(v) + 0.5) * sign(v), 0.0, 65535.0)); }

float greenAt(uint x, uint y) { return float(imageLoad(greenRead, ivec2(int(x), int(y))).r); }

float bayerAt(uint x, uint y) {
    uint want = channelAt(x, y);
    if (want == 1u) return greenAt(x, y);
    if (channelAt(x / pc.block, y / pc.block) == want) return rawAt(int(x), int(y));
    // Block parity of the wanted colour.
    uint parity = want == 0u ? pc.parityR : pc.parityB;
    uint py = parity >> 1u, px = parity & 1u;
    float n = float(pc.block), half_ = float(pc.block - 1u) * 0.5;
    float fx = (float(x) - float(px * pc.block) - half_) / (2.0 * n);
    float fy = (float(y) - float(py * pc.block) - half_) / (2.0 * n);
    int kxMax = int((pc.blocksX - 1u - px) / 2u), kyMax = int((pc.blocksY - 1u - py) / 2u);
    int kx = clamp(int(floor(fx)), 0, kxMax), ky = clamp(int(floor(fy)), 0, kyMax);
    int kx1 = min(kx + 1, kxMax), ky1 = min(ky + 1, kyMax);
    uint bx0 = uint(kx * 2 + int(px)), bx1 = uint(kx1 * 2 + int(px));
    uint by0 = uint(ky * 2 + int(py)), by1 = uint(ky1 * 2 + int(py));
    float tx = clamp(fx - float(kx), 0.0, 1.0), ty = clamp(fy - float(ky), 0.0, 1.0);
    // cfaBlendDiff: bilinear weights scaled by green similarity, so a block
    // across a strong edge doesn't push R/B on the dark side to black.
    float g0 = greenAt(x, y);
    uint bxs[2] = uint[2](bx0, bx1), bys[2] = uint[2](by0, by1);
    float wx[2] = float[2](1.0 - tx, tx), wy[2] = float[2](1.0 - ty, ty);
    float sum = 0.0, weight = 0.0;
    for (int j = 0; j < 2; ++j)
        for (int i = 0; i < 2; ++i) {
            vec2 dg = diffRead.values[bys[j] * pc.blocksX + bxs[i]];
            float sigma = 0.1 * max(g0, dg.y) + 4.0;
            float r = (dg.y - g0) / sigma;
            float wgt = (wx[i] * wy[j] + 1e-4) / (1.0 + r * r);
            sum += wgt * dg.x;
            weight += wgt;
        }
    return g0 + sum / weight;
}

// cfaFastAt: own sample, else block means of the wanted colour interpolated.
float fastAt(uint x, uint y) {
    uint want = channelAt(x, y), bx = x / pc.block, by = y / pc.block;
    if (channelAt(bx, by) == want) return rawAt(int(x), int(y));
    if (want == 1u) {
        int bl = bx > 0u ? int(bx) - 1 : int(bx) + 1, br = bx + 1u < pc.blocksX ? int(bx) + 1 : bl;
        int bt = by > 0u ? int(by) - 1 : int(by) + 1, bb = by + 1u < pc.blocksY ? int(by) + 1 : bt;
        float tx = ((float(x % pc.block) + 0.5) / float(pc.block) + 0.5) * 0.5;
        float ty = ((float(y % pc.block) + 0.5) / float(pc.block) + 0.5) * 0.5;
        float ml = diffRead.values[by * pc.blocksX + uint(bl)].x, mr = diffRead.values[by * pc.blocksX + uint(br)].x;
        float mt = diffRead.values[uint(bt) * pc.blocksX + bx].x, mb = diffRead.values[uint(bb) * pc.blocksX + bx].x;
        float gh = ml + (mr - ml) * tx;
        float gv = mt + (mb - mt) * ty;
        return 0.5 * (gh + gv);
    }
    uint parity = want == 0u ? pc.parityR : pc.parityB;
    uint py = parity >> 1u, px = parity & 1u;
    float n = float(pc.block), half_ = float(pc.block - 1u) * 0.5;
    float fx = (float(x) - float(px * pc.block) - half_) / (2.0 * n);
    float fy = (float(y) - float(py * pc.block) - half_) / (2.0 * n);
    int kxMax = int((pc.blocksX - 1u - px) / 2u), kyMax = int((pc.blocksY - 1u - py) / 2u);
    int kx = clamp(int(floor(fx)), 0, kxMax), ky = clamp(int(floor(fy)), 0, kyMax);
    int kx1 = min(kx + 1, kxMax), ky1 = min(ky + 1, kyMax);
    uint bx0 = uint(kx * 2 + int(px)), bx1 = uint(kx1 * 2 + int(px));
    uint by0 = uint(ky * 2 + int(py)), by1 = uint(ky1 * 2 + int(py));
    float tx = clamp(fx - float(kx), 0.0, 1.0), ty = clamp(fy - float(ky), 0.0, 1.0);
    float m00 = diffRead.values[by0 * pc.blocksX + bx0].x, m10 = diffRead.values[by0 * pc.blocksX + bx1].x;
    float m01 = diffRead.values[by1 * pc.blocksX + bx0].x, m11 = diffRead.values[by1 * pc.blocksX + bx1].x;
    float top = m00 + (m10 - m00) * tx, bottom = m01 + (m11 - m01) * tx;
    return top + (bottom - top) * ty;
}

// Passes 0 and 2 run one invocation per 2x2 pixel group (always inside one
// block, n being 2 or 4): a quarter of the invocations, shared loads, and
// still enough of them in flight. A 16x16 workgroup covers 32x32 pixels, so
// blocks never straddle workgroups; pass 0 sums each block's groups in
// shared memory.
shared float partialSum[16][16];
shared float partialGreen[16][16];
shared uint partialCount[16][16];

void main() {
    uint x = gl_GlobalInvocationID.x, y = gl_GlobalInvocationID.y;
    if (pc.pass == 3u) {
        if (x >= pc.width || y >= pc.height) return;
        uint base = y * pc.rowStrideBytes + (x >> 2u) * 5u, k = x & 3u;
        uint v = (byteAt(base + k) << 2u) | ((byteAt(base + 4u) >> (2u * k)) & 3u);
        imageStore(rawImage, ivec2(int(x), int(y)), uvec4(v, 0u, 0u, 0u));
        return;
    }
    uint x0 = x * 2u, y0 = y * 2u;
    uint x1 = min(pc.width, x0 + 2u), y1 = min(pc.height, y0 + 2u);
    if (pc.pass == 2u || pc.pass == 5u) {
        for (uint py = y0; py < y1; ++py)
            for (uint px = x0; px < x1; ++px) {
                float v = pc.pass == 2u ? bayerAt(px, py) : fastAt(px, py);
                imageStore(dst, ivec2(int(px), int(py)), uvec4(roundDn(v), 0u, 0u, 0u));
            }
        return;
    }
    // Pass 0: green over the group; for R/B blocks the partial sums of raw -
    // green and of green. Pass 4: the partial sum of raw.
    bool colour = channelAt(x0 / pc.block, y0 / pc.block) != 1u;
    float sum = 0.0, greenSum = 0.0;
    uint count = 0u;
    if (pc.pass == 4u) {
        for (uint py = y0; py < y1; ++py)
            for (uint px = x0; px < x1; ++px, ++count) sum += rawAt(int(px), int(py));
    } else {
        float g4[4];
        greenGroup(x0, y0, g4);
        for (uint py = y0; py < y1; ++py)
            for (uint px = x0; px < x1; ++px, ++count) {
                uint g = roundDn(g4[(py - y0) * 2u + (px - x0)]);
                imageStore(greenImage, ivec2(int(px), int(py)), uvec4(g, 0u, 0u, 0u));
                if (colour) {
                    sum += rawAt(int(px), int(py)) - float(g);
                    greenSum += float(g);
                }
            }
    }
    uvec2 l = gl_LocalInvocationID.xy;
    partialSum[l.y][l.x] = sum;
    partialGreen[l.y][l.x] = greenSum;
    partialCount[l.y][l.x] = count;
    barrier();
    // The block's first group adds up the block (n/2 x n/2 groups).
    uint groups = pc.block / 2u;
    if (x % groups != 0u || y % groups != 0u) return;
    uint bx = x0 / pc.block, by = y0 / pc.block;
    if (bx >= pc.blocksX || by >= pc.blocksY) return;
    float total = 0.0, greenTotal = 0.0;
    uint pixels = 0u;
    for (uint j = 0u; j < groups; ++j)
        for (uint i = 0u; i < groups; ++i) {
            total += partialSum[l.y + j][l.x + i];
            greenTotal += partialGreen[l.y + j][l.x + i];
            pixels += partialCount[l.y + j][l.x + i];
        }
    if (pc.pass == 4u)
        diff.values[by * pc.blocksX + bx] = vec2(pixels != 0u ? total / float(pixels) : 0.0, 0.0);
    else
        diff.values[by * pc.blocksX + bx] = colour && pixels != 0u ? vec2(total, greenTotal) / float(pixels) : vec2(0.0);
}
