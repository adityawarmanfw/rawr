#version 450
// Block CFA (quad 2x2 / 4x4 same-colour blocks) -> Bayer remosaic. The camera
// rows are first copied (RAW16, transfer) or unpacked (RAW10, pass 3) into an
// R16 scratch image: image loads are cached in 2D where storage-buffer loads
// of the camera buffer are not (Adreno 840: 9 ms -> see RawRemosaicker.cpp).
// One shader, passes by pc.pass:
//  3. RAW10 only: unpack the camera rows into the raw image;
//  6. exact 2x2 source sum -> half-resolution quarter-DN Quad image;
//  7. High Quad Bayer reconstruction (after pass 0 statistics);
//  8. Detail Quad: green with cubic interpolation into the green image;
//  9. Detail Quad Bayer out (per-pixel colour difference).
// Phase-response fit (Hexadeca reduction only, mirrors imaging/PhaseFit.h):
//  13. clear the statistics; 10. block sums (16 raw samples) into the green
//  image; 11. statistics over a lattice of flat blocks (shared-memory
//  accumulation, then global atomics); 12. curve per (block type, position)
//  from the statistics; pass 6 then divides each sample by its curve value
//  before the exact 2x2 sum. Statistics and curve live in the diff buffer.
// Standard:
//  0. green at every pixel into the green image, and per R/B block the
//     mean of raw - green and the mean green;
//  2. Bayer out into the destination image.
// Fast:
//  4. per block, the mean raw;
//  5. Bayer out from the block means.
// Mirrors app/src/main/cpp/imaging/CfaRemosaic.h expression for expression;
// tests/native/raw_remosaic_vulkan_test.cpp compares the two.
layout(local_size_x = 16, local_size_y = 16) in;
layout(std430, set = 0, binding = 0) readonly buffer Source { uint words[]; } src;
layout(set = 0, binding = 1, r16ui) writeonly uniform uimage2D dst;
// Written through 2/3, read through the readonly aliases 5/6 (same views):
// Adreno caches only readonly image loads.
layout(set = 0, binding = 2, r16ui) writeonly uniform uimage2D rawImage;
layout(set = 0, binding = 3, r16ui) writeonly uniform uimage2D greenImage;
// Per block: Standard (raw - green mean, green mean); Fast (raw mean, unused),
// as float pairs in words 2i, 2i+1. Phase fit: statistics in words [0, 2880),
// curve (floats) from word 2880.
layout(std430, set = 0, binding = 4) buffer Diff { uint words[]; } diff;
layout(set = 0, binding = 5, r16ui) readonly uniform uimage2D rawRead;
layout(set = 0, binding = 6, r16ui) readonly uniform uimage2D greenRead;
layout(std430, set = 0, binding = 7) readonly buffer DiffRead { uint words[]; } diffRead;
layout(push_constant) uniform P {
    uint width;
    uint height;
    uint rowStrideBytes;
    uint block;
    uint order;
    uint raw10;
    uint pass;
    uint blocksX;
    uint blocksY;
    uint parityR;  // block parity of R and B: (py << 1) | px
    uint parityB;
    float codesPerDn;
    float blackLevel;  // raw black (phase fit)
    uint fit;          // pass 6 applies the phase-fit curve
    uint fitStride;    // odd statistics lattice stride
}
pc;

vec2 diffAt(uint i) { return vec2(uintBitsToFloat(diffRead.words[2u * i]), uintBitsToFloat(diffRead.words[2u * i + 1u])); }
void storeDiff(uint i, vec2 v) {
    diff.words[2u * i] = floatBitsToUint(v.x);
    diff.words[2u * i + 1u] = floatBitsToUint(v.y);
}

uint byteAt(uint offset) { return (src.words[offset >> 2u] >> ((offset & 3u) * 8u)) & 0xffu; }

float rawAt(int x, int y) {
    ivec2 p = ivec2(clamp(x, 0, int(pc.width) - 1), clamp(y, 0, int(pc.height) - 1));
    return float(imageLoad(rawRead, p).r);
}

// 0 R, 1 G, 2 B at block (or pixel) parity.
uint channelAt(uint x, uint y) {
    uint i = (y & 1u) * 2u + (x & 1u);
    if (pc.order == 0u) return i == 0u ? 0u : (i == 3u ? 2u : 1u);
    if (pc.order == 1u) return i == 1u ? 0u : (i == 2u ? 2u : 1u);
    if (pc.order == 2u) return i == 2u ? 0u : (i == 1u ? 2u : 1u);
    return i == 3u ? 0u : (i == 0u ? 2u : 1u);
}

// Green for the 2x2 group at (x0, y0), always inside one block. Same
// arithmetic per pixel as CfaRemosaicGreen::at; the horizontal terms depend
// only on the row and the vertical ones only on the column, so each is
// loaded once per group.
// Cubic Hermite between p0 and p1, slopes m0/m1, clamped to [p0, p1]
// (CfaRemosaic.h cfaHermite).
float hermite(float p0, float p1, float m0, float m1, float t) {
    float t2 = t * t, t3 = t2 * t;
    float v = (2.0 * t3 - 3.0 * t2 + 1.0) * p0 + (t3 - 2.0 * t2 + t) * m0 + (-2.0 * t3 + 3.0 * t2) * p1 +
              (t3 - t2) * m1;
    return clamp(v, min(p0, p1), max(p0, p1));
}

void greenGroup(uint x0, uint y0, out float g[4], bool cubic) {
    int N = int(pc.block), X0 = int(x0), Y0 = int(y0);
    int bx = X0 / N * N, by = Y0 / N * N;
    bool green = channelAt(x0 / pc.block, y0 / pc.block) == 1u;
    int xl = bx - 1 >= 0 ? bx - 1 : bx + N;
    int xr = bx + N < int(pc.width) ? bx + N : xl;
    int yt = by - 1 >= 0 ? by - 1 : by + N;
    int yb = by + N < int(pc.height) ? by + N : yt;
    float gh[2][2], gv[2][2], ah[2], av[2];
    for (int j = 0; j < 2; ++j) {
        int Y = Y0 + j;
        float gl = rawAt(xl, Y), gr = rawAt(xr, Y);
        ah[j] = abs(gl - gr) + abs(rawAt(bx, Y) - rawAt(bx + N - 1, Y)) +
                0.5 * abs(rawAt(bx - 2 * N + N - 1, Y) - rawAt(bx + 2 * N, Y));
        for (int i = 0; i < 2; ++i) {
            float th = xr != xl ? float(X0 + i - xl) / float(xr - xl) : 0.5;
            gh[j][i] = gl + (gr - gl) * th;
            if (cubic && xr != xl) {
                float len = float(xr - xl);
                gh[j][i] = hermite(gl, gr, (gl - rawAt(xl - 1, Y)) * len, (rawAt(xr + 1, Y) - gr) * len, th);
            }
        }
    }
    for (int i = 0; i < 2; ++i) {
        int X = X0 + i;
        float gt = rawAt(X, yt), gb = rawAt(X, yb);
        av[i] = abs(gt - gb) + abs(rawAt(X, by) - rawAt(X, by + N - 1)) +
                0.5 * abs(rawAt(X, by - 2 * N + N - 1) - rawAt(X, by + 2 * N));
        for (int j = 0; j < 2; ++j) {
            float tv = yb != yt ? float(Y0 + j - yt) / float(yb - yt) : 0.5;
            gv[j][i] = gt + (gb - gt) * tv;
            if (cubic && yb != yt) {
                float len = float(yb - yt);
                gv[j][i] = hermite(gt, gb, (gt - rawAt(X, yt - 1)) * len, (rawAt(X, yb + 1) - gb) * len, tv);
            }
        }
    }
    float kEps = pc.codesPerDn;
    for (int j = 0; j < 2; ++j)
        for (int i = 0; i < 2; ++i) {
            if (green) {
                g[j * 2 + i] = rawAt(X0 + i, Y0 + j);
                continue;
            }
            float wh = 1.0 / ((ah[j] + kEps) * (ah[j] + kEps)), wv = 1.0 / ((av[i] + kEps) * (av[i] + kEps));
            g[j * 2 + i] = (wh * gh[j][i] + wv * gv[j][i]) / (wh + wv);
        }
}

uint roundDn(float v) { return uint(clamp(floor(abs(v) + 0.5) * sign(v), 0.0, 65535.0)); }

float greenAt(uint x, uint y) { return float(imageLoad(greenRead, ivec2(int(x), int(y))).r); }

float bayerAt(uint x, uint y) {
    uint want = channelAt(x, y);
    if (want == 1u) return greenAt(x, y);
    if (channelAt(x / pc.block, y / pc.block) == want) return rawAt(int(x), int(y));
    // Block parity of the wanted colour.
    uint parity = want == 0u ? pc.parityR : pc.parityB;
    uint py = parity >> 1u, px = parity & 1u;
    float n = float(pc.block), half_ = float(pc.block - 1u) * 0.5;
    float fx = (float(x) - float(px * pc.block) - half_) / (2.0 * n);
    float fy = (float(y) - float(py * pc.block) - half_) / (2.0 * n);
    int kxMax = int((pc.blocksX - 1u - px) / 2u), kyMax = int((pc.blocksY - 1u - py) / 2u);
    int kx = clamp(int(floor(fx)), 0, kxMax), ky = clamp(int(floor(fy)), 0, kyMax);
    int kx1 = min(kx + 1, kxMax), ky1 = min(ky + 1, kyMax);
    uint bx0 = uint(kx * 2 + int(px)), bx1 = uint(kx1 * 2 + int(px));
    uint by0 = uint(ky * 2 + int(py)), by1 = uint(ky1 * 2 + int(py));
    float tx = clamp(fx - float(kx), 0.0, 1.0), ty = clamp(fy - float(ky), 0.0, 1.0);
    // cfaBlendDiff: bilinear weights scaled by green similarity, so a block
    // across a strong edge doesn't push R/B on the dark side to black.
    float g0 = greenAt(x, y);
    uint bxs[2] = uint[2](bx0, bx1), bys[2] = uint[2](by0, by1);
    float wx[2] = float[2](1.0 - tx, tx), wy[2] = float[2](1.0 - ty, ty);
    float sum = 0.0, weight = 0.0;
    for (int j = 0; j < 2; ++j)
        for (int i = 0; i < 2; ++i) {
            vec2 dg = diffAt(bys[j] * pc.blocksX + bxs[i]);
            float sigma = 0.1 * max(g0, dg.y) + 4.0 * pc.codesPerDn;
            float r = (dg.y - g0) / sigma;
            float wgt = (wx[i] * wy[j] + 1e-4) / (1.0 + r * r);
            sum += wgt * dg.x;
            weight += wgt;
        }
    return g0 + sum / weight;
}

// High Quad: CPU radius=2 sub-blocks, same ordered taps and quartic
// green-similarity weights. Standard pass 0 already provides Quad statistics.
float highAt(uint x, uint y) {
    uint want = channelAt(x, y);
    float g0 = greenAt(x, y);
    if (want == 1u) return g0;
    if (channelAt(x / 2u, y / 2u) == want) return rawAt(int(x), int(y));
    ivec2 centre = ivec2(x / 2u, y / 2u);
    vec2 pos = vec2(x & 1u, y & 1u) * 0.5 + 0.25;
    float sum = 0.0, weight = 0.0;
    for (int oy = -2; oy <= 2; ++oy)
        for (int ox = -2; ox <= 2; ++ox) {
            ivec2 q = centre + ivec2(ox, oy);
            if (q.x < 0 || q.y < 0 || q.x >= int(pc.blocksX) || q.y >= int(pc.blocksY)) continue;
            if (channelAt(uint(q.x), uint(q.y)) != want) continue;
            vec2 delta = vec2(ox, oy) + 0.5 - pos;
            float spatial = exp(-(delta.x * delta.x + delta.y * delta.y) * 0.25);
            vec2 dg = diffAt(uint(q.y) * pc.blocksX + uint(q.x));
            float sigma = 0.1 * max(g0, dg.y) + 4.0 * pc.codesPerDn;
            float r = (dg.y - g0) / sigma;
            float w = spatial / (1.0 + r * r * r * r);
            sum += w * dg.x;
            weight += w;
        }
    return g0 + (weight > 0.0 ? sum / weight : 0.0);
}


uint sourceAt(uint x, uint y) {
    if (pc.raw10 != 0u) {
        uint base = y * pc.rowStrideBytes + (x >> 2u) * 5u, k = x & 3u;
        return (byteAt(base + k) << 2u) | ((byteAt(base + 4u) >> (2u * k)) & 3u);
    }
    uint offset = y * pc.rowStrideBytes + 2u * x;
    return byteAt(offset) | (byteAt(offset + 1u) << 8u);
}

// ---- Phase-response fit (see imaging/PhaseFit.h) ----
const uint FIT_BINS = 40u;
const uint FIT_STATS = 2880u;  // 4 * 40 * 18 words
const float FIT_LOG_MIN = 1.3862944;  // ln 4
float fitLogStep() { return log(225.0) / float(FIT_BINS); }
uint fitIndex(uint type, uint bin, uint slot) { return (type * FIT_BINS + bin) * 18u + slot; }
float blockSumAt(uint bx, uint by) { return float(imageLoad(greenRead, ivec2(int(bx), int(by))).r); }
shared uint fitAcc[2880];

// Corrected, summed 2x2 group at (sx, sy) (even): the four samples share one
// 4x4 block, so the brightness lookup is done once.
float fitSum2x2(uint sx, uint sy) {
    uint bx = sx >> 2u, by = sy >> 2u;
    float m = max(blockSumAt(bx, by) / 16.0 - pc.blackLevel, 1.0);
    float f = clamp((log(m) - (FIT_LOG_MIN + 0.5 * fitLogStep())) / fitLogStep(), 0.0, float(FIT_BINS) - 1.001);
    uint i0 = uint(f);
    float fr = f - float(i0);
    uint type = ((by & 1u) << 1u) | (bx & 1u);
    float sum = 0.0;
    for (uint j = 0u; j < 2u; ++j)
        for (uint i = 0u; i < 2u; ++i) {
            uint x = sx + i, y = sy + j, p = ((y & 3u) << 2u) | (x & 3u);
            uint base = FIT_STATS + (type * 16u + p) * FIT_BINS + i0;
            float ratio = uintBitsToFloat(diffRead.words[base]) * (1.0 - fr) + uintBitsToFloat(diffRead.words[base + 1u]) * fr;
            sum += (float(sourceAt(x, y)) - pc.blackLevel) / ratio + pc.blackLevel;
        }
    return sum;
}

void fitFinalizeType(uint type) {
    float stride2 = float(pc.fitStride * pc.fitStride);
    float minBin = max(1.0, floor(300.0 / stride2)), minTotal = max(1.0, floor(2000.0 / stride2));
    uint lutBase = FIT_STATS + type * 16u * FIT_BINS;
    for (uint i = 0u; i < 16u * FIT_BINS; ++i) diff.words[lutBase + i] = floatBitsToUint(1.0);
    float total = 0.0;
    for (uint b = 0u; b < FIT_BINS; ++b) total += float(diff.words[fitIndex(type, b, 0u)]);
    if (total < minTotal) return;
    float logMean[40];
    float ratio[40][16];
    uint used = 0u;
    for (uint b = 0u; b < FIT_BINS; ++b) {
        float n = float(diff.words[fitIndex(type, b, 0u)]);
        if (n < minBin) continue;
        float meanM = float(diff.words[fitIndex(type, b, 1u)]) / 16.0 / n - pc.blackLevel;
        if (!(meanM > 0.0)) continue;
        float mean = 0.0;
        for (uint p = 0u; p < 16u; ++p) {
            ratio[used][p] = (float(diff.words[fitIndex(type, b, 2u + p)]) / n - pc.blackLevel) / meanM;
            mean += ratio[used][p];
        }
        mean /= 16.0;
        for (uint p = 0u; p < 16u; ++p) ratio[used][p] /= mean;
        logMean[used++] = log(meanM);
    }
    if (used < 3u) return;
    for (uint p = 0u; p < 16u; ++p) {
        float curve[40];
        for (uint b = 0u; b < FIT_BINS; ++b) {
            float x = FIT_LOG_MIN + (float(b) + 0.5) * fitLogStep();
            if (x <= logMean[0]) {
                curve[b] = ratio[0][p];
            } else if (x >= logMean[used - 1u]) {
                curve[b] = ratio[used - 1u][p];
            } else {
                uint k = 0u;
                while (k + 2u < used && logMean[k + 1u] < x) ++k;
                float f = (x - logMean[k]) / (logMean[k + 1u] - logMean[k]);
                curve[b] = ratio[k][p] + (ratio[k + 1u][p] - ratio[k][p]) * f;
            }
        }
        for (uint b = 0u; b < FIT_BINS; ++b) {
            float lo = curve[b > 0u ? b - 1u : 0u], hi = curve[b + 1u < FIT_BINS ? b + 1u : FIT_BINS - 1u];
            diff.words[lutBase + p * FIT_BINS + b] = floatBitsToUint(0.25 * lo + 0.5 * curve[b] + 0.25 * hi);
        }
    }
}

// Detail Quad (block 2): the colour difference raw - green of every wanted-
// colour pixel within 3 pixels, Gaussian distance and quartic green-similarity
// weights. Mirrors the Detail branch of remosaicBlockCfa, but visits only the
// 2x2 blocks of the wanted colour (parity pc.parityR/B) instead of testing all
// 49 taps, and takes the separable distance weight from a table.
const float kDetailExp[4] = float[4](1.0, 0.77880079, 0.36787945, 0.10539922);  // exp(-d^2 / 4)

float detailAt(uint x, uint y) {
    uint want = channelAt(x, y);
    float g0 = greenAt(x, y);
    if (want == 1u) return g0;
    if (channelAt(x / 2u, y / 2u) == want) return rawAt(int(x), int(y));
    uint parity = want == 0u ? pc.parityR : pc.parityB;
    int bpy = int(parity >> 1u), bpx = int(parity & 1u);
    int X = int(x), Y = int(y);
    float sum = 0.0, weight = 0.0;
    for (int by = (Y - 3) >> 1; by <= (Y + 3) >> 1; ++by) {
        if ((by & 1) != bpy) continue;
        for (int bx = (X - 3) >> 1; bx <= (X + 3) >> 1; ++bx) {
            if ((bx & 1) != bpx) continue;
            for (int j = 0; j < 2; ++j) {
                int qy = 2 * by + j, dy = qy - Y;
                if (qy < 0 || qy >= int(pc.height) || abs(dy) > 3) continue;
                for (int i = 0; i < 2; ++i) {
                    int qx = 2 * bx + i, dx = qx - X;
                    if (qx < 0 || qx >= int(pc.width) || abs(dx) > 3) continue;
                    float g = greenAt(uint(qx), uint(qy));
                    float sigma = 0.1 * max(g0, g) + 4.0 * pc.codesPerDn;
                    float r = (g - g0) / sigma;
                    float wgt = kDetailExp[abs(dx)] * kDetailExp[abs(dy)] / (1.0 + r * r * r * r);
                    sum += wgt * (rawAt(qx, qy) - g);
                    weight += wgt;
                }
            }
        }
    }
    return g0 + (weight > 0.0 ? sum / weight : 0.0);
}


// cfaFastAt: own sample, else block means of the wanted colour interpolated.
float fastAt(uint x, uint y) {
    uint want = channelAt(x, y), bx = x / pc.block, by = y / pc.block;
    if (channelAt(bx, by) == want) return rawAt(int(x), int(y));
    if (want == 1u) {
        int bl = bx > 0u ? int(bx) - 1 : int(bx) + 1, br = bx + 1u < pc.blocksX ? int(bx) + 1 : bl;
        int bt = by > 0u ? int(by) - 1 : int(by) + 1, bb = by + 1u < pc.blocksY ? int(by) + 1 : bt;
        float tx = ((float(x % pc.block) + 0.5) / float(pc.block) + 0.5) * 0.5;
        float ty = ((float(y % pc.block) + 0.5) / float(pc.block) + 0.5) * 0.5;
        float ml = diffAt(by * pc.blocksX + uint(bl)).x, mr = diffAt(by * pc.blocksX + uint(br)).x;
        float mt = diffAt(uint(bt) * pc.blocksX + bx).x, mb = diffAt(uint(bb) * pc.blocksX + bx).x;
        float gh = ml + (mr - ml) * tx;
        float gv = mt + (mb - mt) * ty;
        return 0.5 * (gh + gv);
    }
    uint parity = want == 0u ? pc.parityR : pc.parityB;
    uint py = parity >> 1u, px = parity & 1u;
    float n = float(pc.block), half_ = float(pc.block - 1u) * 0.5;
    float fx = (float(x) - float(px * pc.block) - half_) / (2.0 * n);
    float fy = (float(y) - float(py * pc.block) - half_) / (2.0 * n);
    int kxMax = int((pc.blocksX - 1u - px) / 2u), kyMax = int((pc.blocksY - 1u - py) / 2u);
    int kx = clamp(int(floor(fx)), 0, kxMax), ky = clamp(int(floor(fy)), 0, kyMax);
    int kx1 = min(kx + 1, kxMax), ky1 = min(ky + 1, kyMax);
    uint bx0 = uint(kx * 2 + int(px)), bx1 = uint(kx1 * 2 + int(px));
    uint by0 = uint(ky * 2 + int(py)), by1 = uint(ky1 * 2 + int(py));
    float tx = clamp(fx - float(kx), 0.0, 1.0), ty = clamp(fy - float(ky), 0.0, 1.0);
    float m00 = diffAt(by0 * pc.blocksX + bx0).x, m10 = diffAt(by0 * pc.blocksX + bx1).x;
    float m01 = diffAt(by1 * pc.blocksX + bx0).x, m11 = diffAt(by1 * pc.blocksX + bx1).x;
    float top = m00 + (m10 - m00) * tx, bottom = m01 + (m11 - m01) * tx;
    return top + (bottom - top) * ty;
}

// Tiled Detail Bayer out: a workgroup (32x32 pixels) first loads green and raw of its
// pixels plus a 3-pixel halo into shared memory (green | raw << 16), then every pixel
// walks its wanted-colour taps there instead of in the images. Same arithmetic as detailAt.
const int DETAIL_TILE = 38;
shared uint detailTile[38 * 38];

uint detailTileAt(ivec2 p, ivec2 origin) { return detailTile[(p.y - origin.y) * DETAIL_TILE + (p.x - origin.x)]; }

float detailAtTile(uint x, uint y, ivec2 origin) {
    uint want = channelAt(x, y);
    uint here = detailTileAt(ivec2(x, y), origin);
    float g0 = float(here & 0xffffu);
    if (want == 1u) return g0;
    if (channelAt(x / 2u, y / 2u) == want) return float(here >> 16u);
    uint parity = want == 0u ? pc.parityR : pc.parityB;
    int bpy = int(parity >> 1u), bpx = int(parity & 1u);
    int X = int(x), Y = int(y);
    // The taps are the wanted-colour columns x rows of the 7x7 window (at most 4 each): the
    // distance weight is separable, so list the columns and rows once.
    int cols[4], rows[4];
    float wc[4], wr[4];
    int nc = 0, nr = 0;
    for (int q = X - 3; q <= X + 3; ++q)
        if (((q >> 1) & 1) == bpx && q >= 0 && q < int(pc.width)) {
            cols[nc] = q;
            wc[nc++] = kDetailExp[abs(q - X)];
        }
    for (int q = Y - 3; q <= Y + 3; ++q)
        if (((q >> 1) & 1) == bpy && q >= 0 && q < int(pc.height)) {
            rows[nr] = q;
            wr[nr++] = kDetailExp[abs(q - Y)];
        }
    float floorSigma = 4.0 * pc.codesPerDn, sum = 0.0, weight = 0.0;
    for (int j = 0; j < nr; ++j)
        for (int i = 0; i < nc; ++i) {
            uint t = detailTileAt(ivec2(cols[i], rows[j]), origin);
            float g = float(t & 0xffffu);
            // spatial / (1 + (d / s)^4) with one division
            float d = g - g0, sg = 0.1 * max(g0, g) + floorSigma;
            float d2 = d * d, s2 = sg * sg, s4 = s2 * s2;
            float wgt = wc[i] * wr[j] * s4 / (s4 + d2 * d2);
            sum += wgt * (float(t >> 16u) - g);
            weight += wgt;
        }
    return g0 + (weight > 0.0 ? sum / weight : 0.0);
}

// Passes 0 and 2 run one invocation per 2x2 pixel group (always inside one
// block, n being 2 or 4): a quarter of the invocations, shared loads, and
// still enough of them in flight. A 16x16 workgroup covers 32x32 pixels, so
// blocks never straddle workgroups; pass 0 sums each block's groups in
// shared memory.
shared float partialSum[16][16];
shared float partialGreen[16][16];
shared uint partialCount[16][16];

void main() {
    uint x = gl_GlobalInvocationID.x, y = gl_GlobalInvocationID.y;
    if (pc.pass == 13u) {  // clear the statistics
        for (uint i = gl_LocalInvocationIndex; i < FIT_STATS; i += 256u) diff.words[i] = 0u;
        return;
    }
    if (pc.pass == 10u) {  // block sums (reduced width / 2 blocks per row)
        if (x >= pc.width / 2u || y >= pc.height / 2u) return;
        uint sum = 0u;
        for (uint j = 0u; j < 4u; ++j)
            for (uint i = 0u; i < 4u; ++i) sum += sourceAt(4u * x + i, 4u * y + j);
        imageStore(greenImage, ivec2(int(x), int(y)), uvec4(min(sum, 65535u), 0u, 0u, 0u));
        return;
    }
    if (pc.pass == 11u) {  // statistics on a stride lattice of flat blocks
        for (uint i = gl_LocalInvocationIndex; i < FIT_STATS; i += 256u) fitAcc[i] = 0u;
        barrier();
        uint bw4 = pc.width / 2u, bh4 = pc.height / 2u;
        uint bx = 4u + x * pc.fitStride, by = 4u + y * pc.fitStride;
        if (bx + 4u <= bw4 && by + 4u <= bh4) {
            float m = blockSumAt(bx, by) / 16.0 - pc.blackLevel;
            if (m > 4.0) {
                float dev = 0.0;
                dev = max(dev, abs(blockSumAt(bx + 2u, by) / 16.0 - pc.blackLevel - m));
                dev = max(dev, abs(blockSumAt(bx - 2u, by) / 16.0 - pc.blackLevel - m));
                dev = max(dev, abs(blockSumAt(bx, by + 2u) / 16.0 - pc.blackLevel - m));
                dev = max(dev, abs(blockSumAt(bx, by - 2u) / 16.0 - pc.blackLevel - m));
                float allowance = 0.03 * m + 2.5 * sqrt((0.5 * max(m, 0.0) + 9.0) / 16.0 * 2.0);
                if (dev < allowance) {
                    uint bin = uint(clamp(int(floor((log(m) - FIT_LOG_MIN) / fitLogStep())), 0, int(FIT_BINS) - 1));
                    uint type = (by & 1u) * 2u + (bx & 1u);
                    atomicAdd(fitAcc[fitIndex(type, bin, 0u)], 1u);
                    atomicAdd(fitAcc[fitIndex(type, bin, 1u)], uint(blockSumAt(bx, by)));
                    for (uint p = 0u; p < 16u; ++p)
                        atomicAdd(fitAcc[fitIndex(type, bin, 2u + p)], sourceAt(bx * 4u + (p & 3u), by * 4u + (p >> 2u)));
                }
            }
        }
        barrier();
        for (uint i = gl_LocalInvocationIndex; i < FIT_STATS; i += 256u) {
            uint v = fitAcc[i];
            if (v != 0u) atomicAdd(diff.words[i], v);
        }
        return;
    }
    if (pc.pass == 12u) {  // curve per block type
        if (gl_LocalInvocationIndex < 4u) fitFinalizeType(gl_LocalInvocationIndex);
        return;
    }
    if (pc.pass == 6u) {
        if (x >= pc.width || y >= pc.height) return;
        uint sx = 2u*x, sy = 2u*y;
        if (pc.fit != 0u) {
            float s = fitSum2x2(sx, sy);
            imageStore(rawImage, ivec2(x,y), uvec4(roundDn(s), 0u, 0u, 0u));
            return;
        }
        uint sum = sourceAt(sx,sy) + sourceAt(sx+1u,sy) + sourceAt(sx,sy+1u) + sourceAt(sx+1u,sy+1u);
        imageStore(rawImage, ivec2(x,y), uvec4(sum,0u,0u,0u));
        return;
    }
    if (pc.pass == 3u) {
        if (x >= pc.width || y >= pc.height) return;
        uint base = y * pc.rowStrideBytes + (x >> 2u) * 5u, k = x & 3u;
        uint v = (byteAt(base + k) << 2u) | ((byteAt(base + 4u) >> (2u * k)) & 3u);
        imageStore(rawImage, ivec2(int(x), int(y)), uvec4(v, 0u, 0u, 0u));
        return;
    }
    uint x0 = x * 2u, y0 = y * 2u;
    uint x1 = min(pc.width, x0 + 2u), y1 = min(pc.height, y0 + 2u);
    if (pc.pass == 9u) {
        ivec2 origin = ivec2(gl_WorkGroupID.xy) * 32 - 3;
        for (uint i = gl_LocalInvocationIndex; i < uint(DETAIL_TILE * DETAIL_TILE); i += 256u) {
            ivec2 p = origin + ivec2(int(i) % DETAIL_TILE, int(i) / DETAIL_TILE);
            uint v = 0u;
            if (p.x >= 0 && p.y >= 0 && p.x < int(pc.width) && p.y < int(pc.height))
                v = imageLoad(greenRead, p).r | (imageLoad(rawRead, p).r << 16u);
            detailTile[i] = v;
        }
        barrier();
        for (uint py = y0; py < y1; ++py)
            for (uint px = x0; px < x1; ++px)
                imageStore(dst, ivec2(int(px), int(py)), uvec4(roundDn(detailAtTile(px, py, origin)), 0u, 0u, 0u));
        return;
    }
    if (pc.pass == 2u || pc.pass == 5u || pc.pass == 7u) {
        for (uint py = y0; py < y1; ++py)
            for (uint px = x0; px < x1; ++px) {
                float v = pc.pass == 7u ? highAt(px, py) : (pc.pass == 2u ? bayerAt(px, py) : fastAt(px, py));
                imageStore(dst, ivec2(int(px), int(py)), uvec4(roundDn(v), 0u, 0u, 0u));
            }
        return;
    }
    if (pc.pass == 8u) {
        float g4[4];
        greenGroup(x0, y0, g4, true);
        for (uint py = y0; py < y1; ++py)
            for (uint px = x0; px < x1; ++px)
                imageStore(greenImage, ivec2(int(px), int(py)), uvec4(roundDn(g4[(py - y0) * 2u + (px - x0)]), 0u, 0u, 0u));
        return;
    }
    // Pass 0: green over the group; for R/B blocks the partial sums of raw -
    // green and of green. Pass 4: the partial sum of raw.
    bool colour = channelAt(x0 / pc.block, y0 / pc.block) != 1u;
    float sum = 0.0, greenSum = 0.0;
    uint count = 0u;
    if (pc.pass == 4u) {
        for (uint py = y0; py < y1; ++py)
            for (uint px = x0; px < x1; ++px, ++count) sum += rawAt(int(px), int(py));
    } else {
        float g4[4];
        greenGroup(x0, y0, g4, false);
        for (uint py = y0; py < y1; ++py)
            for (uint px = x0; px < x1; ++px, ++count) {
                uint g = roundDn(g4[(py - y0) * 2u + (px - x0)]);
                imageStore(greenImage, ivec2(int(px), int(py)), uvec4(g, 0u, 0u, 0u));
                if (colour) {
                    sum += rawAt(int(px), int(py)) - float(g);
                    greenSum += float(g);
                }
            }
    }
    uvec2 l = gl_LocalInvocationID.xy;
    partialSum[l.y][l.x] = sum;
    partialGreen[l.y][l.x] = greenSum;
    partialCount[l.y][l.x] = count;
    barrier();
    // The block's first group adds up the block (n/2 x n/2 groups).
    uint groups = pc.block / 2u;
    if (x % groups != 0u || y % groups != 0u) return;
    uint bx = x0 / pc.block, by = y0 / pc.block;
    if (bx >= pc.blocksX || by >= pc.blocksY) return;
    float total = 0.0, greenTotal = 0.0;
    uint pixels = 0u;
    for (uint j = 0u; j < groups; ++j)
        for (uint i = 0u; i < groups; ++i) {
            total += partialSum[l.y + j][l.x + i];
            greenTotal += partialGreen[l.y + j][l.x + i];
            pixels += partialCount[l.y + j][l.x + i];
        }
    if (pc.pass == 4u)
        storeDiff(by * pc.blocksX + bx, vec2(pixels != 0u ? total / float(pixels) : 0.0, 0.0));
    else
        storeDiff(by * pc.blocksX + bx, colour && pixels != 0u ? vec2(total, greenTotal) / float(pixels) : vec2(0.0));
}
