#version 450
// Anti-aliased 2x reduction for recordings smaller than the sensor crop
// (1080p from the 3840x2160 crop). The full-resolution demosaic is filtered
// in linear light with a separable Lanczos-3 whose cutoff sits at 0.87x the
// output Nyquist (kernel stretched 1.15x), then decimated. Against the former
// 2x2 box average this removes about 5x more aliasing (moire, stair-stepped
// edges) while keeping slightly more real detail; see tmp/downscale_eval.
#define TILE 16
layout(local_size_x = TILE, local_size_y = TILE, local_size_z = 1) in;
layout(binding = 0, rgba16f) uniform readonly image2D fullImage;
layout(binding = 1, r16ui) uniform readonly uimage2D fullClip;
layout(binding = 2, rgba16f) uniform writeonly image2D outImage;
layout(binding = 3, r16ui) uniform writeonly uimage2D outClip;
layout(push_constant) uniform DownscaleParams {
    uint outWidth;
    uint outHeight;
    uint fullWidth;
    uint fullHeight;
} pc;

// Taps per side; input pixel j sits at offset (j + 0.5) - (2o + 1) from the
// centre of output pixel o, i.e. +-0.5 .. +-6.5. Normalized weights by |offset|.
const int SIDE_TAPS = 7;
const int TAPS = 2 * SIDE_TAPS;
const float kWeights[SIDE_TAPS] = float[](0.3995578, 0.1746549, -0.0274861, -0.0571024, -0.0041872, 0.0130009,
                                          0.0015621);
// Input rows/columns one workgroup reads: 2 * TILE plus the kernel apron.
const int SPAN = 2 * TILE + TAPS - 2;

// Half-float RGB keeps both tiles within the 32 KB shared-memory budget.
shared uvec2 tileIn[SPAN * SPAN];
shared uvec2 tileRows[SPAN * TILE];

uvec2 packRgb(vec3 v) { return uvec2(packHalf2x16(v.rg), packHalf2x16(vec2(v.b, 0.0))); }
vec3 unpackRgb(uvec2 p) { return vec3(unpackHalf2x16(p.x), unpackHalf2x16(p.y).x); }

float weightAt(int m) { return kWeights[m < SIDE_TAPS ? SIDE_TAPS - 1 - m : m - SIDE_TAPS]; }

void main() {
    ivec2 tileOut = ivec2(gl_WorkGroupID.xy) * TILE;
    ivec2 origin = tileOut * 2 - (SIDE_TAPS - 1);
    ivec2 last = ivec2(pc.fullWidth, pc.fullHeight) - 1;
    for (uint index = gl_LocalInvocationIndex; index < uint(SPAN * SPAN); index += uint(TILE * TILE)) {
        ivec2 q = clamp(origin + ivec2(int(index % uint(SPAN)), int(index / uint(SPAN))), ivec2(0), last);
        tileIn[index] = packRgb(imageLoad(fullImage, q).rgb);
    }
    barrier();

    // Horizontal pass: every input row of the tile, decimated to TILE columns.
    for (uint index = gl_LocalInvocationIndex; index < uint(SPAN * TILE); index += uint(TILE * TILE)) {
        int row = int(index / uint(TILE));
        int column = int(index % uint(TILE));
        vec3 sum = vec3(0.0);
        for (int m = 0; m < TAPS; ++m) sum += weightAt(m) * unpackRgb(tileIn[row * SPAN + 2 * column + m]);
        tileRows[index] = packRgb(sum);
    }
    barrier();

    ivec2 local = ivec2(gl_LocalInvocationID.xy);
    ivec2 outPixel = tileOut + local;
    if (outPixel.x >= int(pc.outWidth) || outPixel.y >= int(pc.outHeight)) return;
    vec3 sum = vec3(0.0);
    for (int m = 0; m < TAPS; ++m) sum += weightAt(m) * unpackRgb(tileRows[(2 * local.y + m) * TILE + local.x]);
    // Anti-ringing: stay within the central 4x4 input footprint, so negative
    // lobes cannot draw halos around highlights or high-contrast edges.
    vec3 lo = vec3(65504.0), hi = vec3(0.0);
    for (int y = SIDE_TAPS - 2; y < SIDE_TAPS + 2; ++y) {
        for (int x = SIDE_TAPS - 2; x < SIDE_TAPS + 2; ++x) {
            vec3 v = unpackRgb(tileIn[(2 * local.y + y) * SPAN + 2 * local.x + x]);
            lo = min(lo, v);
            hi = max(hi, v);
        }
    }
    imageStore(outImage, outPixel, vec4(clamp(sum, lo, hi), 1.0));

    // Clip state stays per 2x2 output block: OR the four full-resolution
    // blocks (each 2x2 RAW pixels) it covers.
    if ((outPixel.x & 1) == 0 && (outPixel.y & 1) == 0) {
        uint state = 0u;
        for (int y = 0; y < 2; ++y)
            for (int x = 0; x < 2; ++x) state |= imageLoad(fullClip, outPixel + ivec2(x, y)).r;
        imageStore(outClip, outPixel / 2, uvec4(state, 0u, 0u, 0u));
    }
}
