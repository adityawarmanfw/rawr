#version 450
#extension GL_GOOGLE_include_directive : require

// Recording demosaic; writes pre-WB RGB and sensor clip state for post processing.
#define VIDEO_TILE 16
layout(local_size_x = VIDEO_TILE, local_size_y = VIDEO_TILE, local_size_z = 1) in;
#define VIDEO_RAW_IMAGE_BINDING 0
#define VIDEO_RAW_BUFFER_BINDING 1
#define VIDEO_LSC_BINDING 3
#include "video_raw_core.glsl"
layout(binding = 2, rgba16f) uniform writeonly image2D linearOut;
layout(binding = 4, r16ui) uniform writeonly uimage2D clipStateOut;

void main() {
    videoLoadTile();
    ivec2 outPixel = ivec2(gl_GlobalInvocationID.xy);
    if (outPixel.x >= int(pc.outWidth) || outPixel.y >= int(pc.outHeight)) return;
    imageStore(linearOut, outPixel, vec4(videoSensorAt(outPixel), 1.0));
    if ((outPixel.x & 1) == 0 && (outPixel.y & 1) == 0) {
        ivec2 base = ivec2(pc.cropX, pc.cropY) + outPixel * (pc.reduceCfa != 0u ? 2 : 1);
        int side = pc.reduceCfa != 0u ? 4 : 2;
        uint state = 0u;
        for (int y = 0; y < side; ++y) {
            for (int x = 0; x < side; ++x) {
                ivec2 q = base + ivec2(x, y);
                int c = videoChannelAt(q);
                // The cache holds the normalized sample clamped to [0, 1],
                // which leaves this >= 0.995 test unchanged.
                if (videoCachedAt(q) >= 0.995) state |= 1u << uint(c);
            }
        }
        imageStore(clipStateOut, outPixel / 2, uvec4(state, 0u, 0u, 0u));
    }
}
